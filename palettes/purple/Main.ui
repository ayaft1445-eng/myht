// Главное окно HUB.
// Палитра фиолетовая: фон и карточки собраны из полос с промежуточными
// оттенками — так получается плавный переход цвета (настоящих градиентов
// в разметке нет). Числа в скобках у цвета — прозрачность.

@Card = TextButtonStyle(
  Default: (Background: #4b1d7a(0.10), LabelStyle: (FontSize: 26, TextColor: #c8a2ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #9b5de5(0.28), LabelStyle: (FontSize: 26, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #c8a2ff(0.35), LabelStyle: (FontSize: 26, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@Flat = TextButtonStyle(
  Default: (Background: #4b1d7a(0.55), LabelStyle: (FontSize: 15, TextColor: #c8a2ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #6a2ba8(0.75), LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #9b5de5(0.60), LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

Group {
  Anchor: (Width: 1440, Height: 660);
  LayoutMode: Top;

  Group { Anchor: (Height: 2); Background: #9b5de5; }

  Group {
    FlexWeight: 1;
    LayoutMode: Left;

    Group { Anchor: (Width: 2); Background: #9b5de5; }

    Group {
      FlexWeight: 1;

      Group {
        Anchor: (Full: 0);
        LayoutMode: Top;

        Group { FlexWeight: 1; Background: #1a0b2e(0.72); }
        Group { FlexWeight: 1; Background: #1c0c31(0.72); }
        Group { FlexWeight: 1; Background: #1e0c34(0.72); }
        Group { FlexWeight: 1; Background: #1f0d37(0.72); }
        Group { FlexWeight: 1; Background: #210e3a(0.72); }
        Group { FlexWeight: 1; Background: #230e3d(0.72); }
        Group { FlexWeight: 1; Background: #250f41(0.72); }
        Group { FlexWeight: 1; Background: #270f44(0.72); }
        Group { FlexWeight: 1; Background: #291047(0.72); }
        Group { FlexWeight: 1; Background: #2a114a(0.72); }
        Group { FlexWeight: 1; Background: #2c114d(0.72); }
        Group { FlexWeight: 1; Background: #2e1250(0.72); }
      }

      Group {
        Anchor: (Full: 0);
        LayoutMode: Top;
        Padding: (Full: 24);

        Label {
          Text: "HUB";
          Anchor: (Height: 60);
          Style: (FontSize: 44, TextColor: #c8a2ff, HorizontalAlignment: Center, RenderBold: true);
        }

        Group { Anchor: (Height: 16); }

        Group {
          Anchor: (Height: 470);
          LayoutMode: Left;

          Group {
            Anchor: (Width: 560, Height: 470);
            LayoutMode: Top;

            Group { Anchor: (Height: 2); Background: #c8a2ff; }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;

              Group { Anchor: (Width: 2); Background: #c8a2ff; }

              Group {
                FlexWeight: 1;

                // Подложка — видна, если текстура не загрузилась.
                Group { Anchor: (Full: 0); Background: #2e1250; }

                // Фон карточки. Картинки лежат в подпапке Assets рядом с разметкой.
                Group { Anchor: (Full: 0); Background: (TexturePath: "Assets/Card_Minigames.png"); }


                TextButton #BtnMinigames {
                  Text: "";
                  Anchor: (Full: 0);
                  Style: @Card;
                }

                Label {
                  Text: "МИНИ-ИГРЫ";
                  Anchor: (Height: 40, Bottom: 20);
                  Style: (FontSize: 32, TextColor: #c8a2ff, HorizontalAlignment: Center, RenderBold: true);
                }
              }

              Group { Anchor: (Width: 2); Background: #c8a2ff; }
            }

            Group { Anchor: (Height: 2); Background: #c8a2ff; }
          }
          Group { Anchor: (Width: 16); }
          Group {
            Anchor: (Width: 260, Height: 470);
            LayoutMode: Top;

            Group { Anchor: (Height: 2); Background: #c8a2ff; }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;

              Group { Anchor: (Width: 2); Background: #c8a2ff; }

              Group {
                FlexWeight: 1;

                // Подложка — видна, если текстура не загрузилась.
                Group { Anchor: (Full: 0); Background: #2e1250; }

                // Фон карточки. Картинки лежат в подпапке Assets рядом с разметкой.
                Group { Anchor: (Full: 0); Background: (TexturePath: "Assets/Card_News.png"); }


                TextButton #BtnNews {
                  Text: "";
                  Anchor: (Full: 0);
                  Style: @Card;
                }

                Label {
                  Text: "НОВОСТИ";
                  Anchor: (Height: 34, Bottom: 20);
                  Style: (FontSize: 26, TextColor: #c8a2ff, HorizontalAlignment: Center, RenderBold: true);
                }
              }

              Group { Anchor: (Width: 2); Background: #c8a2ff; }
            }

            Group { Anchor: (Height: 2); Background: #c8a2ff; }
          }
          Group { Anchor: (Width: 16); }
          Group {
            Anchor: (Width: 260, Height: 470);
            LayoutMode: Top;

            Group { Anchor: (Height: 2); Background: #c8a2ff; }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;

              Group { Anchor: (Width: 2); Background: #c8a2ff; }

              Group {
                FlexWeight: 1;

                // Подложка — видна, если текстура не загрузилась.
                Group { Anchor: (Full: 0); Background: #2e1250; }

                // Фон карточки. Картинки лежат в подпапке Assets рядом с разметкой.
                Group { Anchor: (Full: 0); Background: (TexturePath: "Assets/Card_Rules.png"); }


                TextButton #BtnRules {
                  Text: "";
                  Anchor: (Full: 0);
                  Style: @Card;
                }

                Label {
                  Text: "ПРАВИЛА";
                  Anchor: (Height: 34, Bottom: 20);
                  Style: (FontSize: 26, TextColor: #c8a2ff, HorizontalAlignment: Center, RenderBold: true);
                }
              }

              Group { Anchor: (Width: 2); Background: #c8a2ff; }
            }

            Group { Anchor: (Height: 2); Background: #c8a2ff; }
          }
          Group { Anchor: (Width: 16); }
          Group {
            Anchor: (Width: 260, Height: 470);
            LayoutMode: Top;

            Group { Anchor: (Height: 2); Background: #c8a2ff; }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;

              Group { Anchor: (Width: 2); Background: #c8a2ff; }

              Group {
                FlexWeight: 1;

                // Подложка — видна, если текстура не загрузилась.
                Group { Anchor: (Full: 0); Background: #2e1250; }

                // Фон карточки. Картинки лежат в подпапке Assets рядом с разметкой.
                Group { Anchor: (Full: 0); Background: (TexturePath: "Assets/Card_Discord.png"); }


                TextButton #BtnDiscord {
                  Text: "";
                  Anchor: (Full: 0);
                  Style: @Card;
                }

                Label {
                  Text: "ДС СЕРВЕР";
                  Anchor: (Height: 34, Bottom: 20);
                  Style: (FontSize: 26, TextColor: #c8a2ff, HorizontalAlignment: Center, RenderBold: true);
                }
              }

              Group { Anchor: (Width: 2); Background: #c8a2ff; }
            }

            Group { Anchor: (Height: 2); Background: #c8a2ff; }
          }
        }

        Group { Anchor: (Height: 14); }

        Label {
          Text: "ESC — закрыть меню";
          Anchor: (Height: 18);
          Style: (FontSize: 13, TextColor: #9b5de5, HorizontalAlignment: Center);
        }
      }
    }

    Group { Anchor: (Width: 2); Background: #9b5de5; }
  }

  Group { Anchor: (Height: 2); Background: #9b5de5; }
}
