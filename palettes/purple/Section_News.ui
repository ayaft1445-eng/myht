// Окно «Новости». Текст — в строках Text.

@Card = TextButtonStyle(
  Default: (Background: #4b1d7a(0.10), LabelStyle: (FontSize: 26, TextColor: #c8a2ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #9b5de5(0.28), LabelStyle: (FontSize: 26, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #c8a2ff(0.35), LabelStyle: (FontSize: 26, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@Flat = TextButtonStyle(
  Default: (Background: #4b1d7a(0.55), LabelStyle: (FontSize: 15, TextColor: #c8a2ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #6a2ba8(0.75), LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #9b5de5(0.60), LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

Group {
  Anchor: (Width: 1440, Height: 660);
  LayoutMode: Top;

  Group { Anchor: (Height: 2); Background: #9b5de5; }

  Group {
    FlexWeight: 1;
    LayoutMode: Left;

    Group { Anchor: (Width: 2); Background: #9b5de5; }

    Group {
      FlexWeight: 1;

      Group {
        Anchor: (Full: 0);
        LayoutMode: Top;

        Group { Anchor: (Height: 82); Background: #1a0b2e(0.72); }
        Group { Anchor: (Height: 82); Background: #1d0c32(0.72); }
        Group { Anchor: (Height: 82); Background: #200d36(0.72); }
        Group { Anchor: (Height: 82); Background: #230e3a(0.72); }
        Group { Anchor: (Height: 82); Background: #260f3f(0.72); }
        Group { Anchor: (Height: 82); Background: #291043(0.72); }
        Group { Anchor: (Height: 82); Background: #2b1147(0.72); }
        Group { Anchor: (Height: 82); Background: #2e1250(0.72); }
      }

      Group {
        Anchor: (Full: 0);
        LayoutMode: Top;
        Padding: (Full: 24);

        Group {
          Anchor: (Height: 56);
          LayoutMode: Left;

            Group {
              Anchor: (Width: 160, Height: 44);
              LayoutMode: Top;

              Group { Anchor: (Height: 2); Background: #9b5de5; }

              Group {
                FlexWeight: 1;
                LayoutMode: Left;

                Group { Anchor: (Width: 2); Background: #9b5de5; }

                Group {
                  FlexWeight: 1;

                  TextButton #BackButton {
                    Text: "НАЗАД";
                    Anchor: (Full: 0);
                    Style: @Flat;
                  }
                }

                Group { Anchor: (Width: 2); Background: #9b5de5; }
              }

              Group { Anchor: (Height: 2); Background: #9b5de5; }
            }

            Group {
              FlexWeight: 1;
              LayoutMode: Center;

              Label {
                Text: "НОВОСТИ";
                Anchor: (Height: 48);
                Style: (FontSize: 36, TextColor: #c8a2ff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
              }
            }

            Group { Anchor: (Width: 160); }
        }

        Group { Anchor: (Height: 2); Background: #9b5de5; }
        Group { Anchor: (Height: 18); }

        Group {
          FlexWeight: 1;
          LayoutMode: Top;

          Group { Anchor: (Height: 2); Background: #9b5de5; }

          Group {
            FlexWeight: 1;
            LayoutMode: Left;

            Group { Anchor: (Width: 2); Background: #9b5de5; }

            Group {
              FlexWeight: 1;

              Group {
                Anchor: (Full: 0);
                LayoutMode: Top;

                Group { FlexWeight: 1; Background: #2e1250(0.4); }
                Group { FlexWeight: 1; Background: #311354(0.4); }
                Group { FlexWeight: 1; Background: #331458(0.4); }
                Group { FlexWeight: 1; Background: #36155b(0.4); }
                Group { FlexWeight: 1; Background: #39165f(0.4); }
                Group { FlexWeight: 1; Background: #3b1763(0.4); }
                Group { FlexWeight: 1; Background: #3e1867(0.4); }
                Group { FlexWeight: 1; Background: #40196b(0.4); }
                Group { FlexWeight: 1; Background: #431a6f(0.4); }
                Group { FlexWeight: 1; Background: #461b72(0.4); }
                Group { FlexWeight: 1; Background: #481c76(0.4); }
                Group { FlexWeight: 1; Background: #4b1d7a(0.4); }
              }
              Group {
                Anchor: (Full: 0);
                LayoutMode: Top;
                Padding: (Full: 24);

                  Label {
                    Text: "ОТКРЫТИЕ СЕРВЕРА";
                    Anchor: (Height: 32);
                    Style: (FontSize: 22, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
                  }
                  Label {
                    Text: "Мы запустились! Заходите, зовите друзей";
                    Anchor: (Height: 24);
                    Style: (FontSize: 16, TextColor: #c8a2ff, HorizontalAlignment: Center);
                  }
                  Label {
                    Text: "и пишите о багах в Discord.";
                    Anchor: (Height: 24);
                    Style: (FontSize: 16, TextColor: #c8a2ff, HorizontalAlignment: Center);
                  }
                  Group { Anchor: (Height: 18); }
                  Label {
                    Text: "НОВАЯ МИНИ-ИГРА";
                    Anchor: (Height: 32);
                    Style: (FontSize: 22, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
                  }
                  Label {
                    Text: "Скоро добавим «Захват флага»:";
                    Anchor: (Height: 24);
                    Style: (FontSize: 16, TextColor: #c8a2ff, HorizontalAlignment: Center);
                  }
                  Label {
                    Text: "две команды, один флаг, много шума.";
                    Anchor: (Height: 24);
                    Style: (FontSize: 16, TextColor: #c8a2ff, HorizontalAlignment: Center);
                  }
                  Group { Anchor: (Height: 18); }
                  Label {
                    Text: "ОБНОВЛЕНИЕ МИРА";
                    Anchor: (Height: 32);
                    Style: (FontSize: 22, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
                  }
                  Label {
                    Text: "Спавн перестроен, добавлены порталы";
                    Anchor: (Height: 24);
                    Style: (FontSize: 16, TextColor: #c8a2ff, HorizontalAlignment: Center);
                  }
                  Label {
                    Text: "к аренам и торговой площади.";
                    Anchor: (Height: 24);
                    Style: (FontSize: 16, TextColor: #c8a2ff, HorizontalAlignment: Center);
                  }
                  Group { Anchor: (Height: 18); }
              }
            }

            Group { Anchor: (Width: 2); Background: #9b5de5; }
          }

          Group { Anchor: (Height: 2); Background: #9b5de5; }
        }

        Group { Anchor: (Height: 14); }

        Label {
          Text: "ESC — закрыть меню";
          Anchor: (Height: 18);
          Style: (FontSize: 13, TextColor: #9b5de5, HorizontalAlignment: Center);
        }
      }
    }

    Group { Anchor: (Width: 2); Background: #9b5de5; }
  }

  Group { Anchor: (Height: 2); Background: #9b5de5; }
}
