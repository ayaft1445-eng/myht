// Главное окно меню сервера: три большие кнопки.
// Нажатие на кнопку сервер обрабатывает в HubPage.java и открывает окно раздела.

@BigButtonStyle = TextButtonStyle(
  Default: (Background: #7c3aed, LabelStyle: (FontSize: 20, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #8b5cf6, LabelStyle: (FontSize: 20, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #6d28d9, LabelStyle: (FontSize: 20, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@CloseStyle = TextButtonStyle(
  Default: (Background: #2d1b4e, LabelStyle: (FontSize: 16, TextColor: #c4b5fd, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #3b2566, LabelStyle: (FontSize: 16, TextColor: #e9d5ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #241040, LabelStyle: (FontSize: 16, TextColor: #c4b5fd, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

Group {
  Anchor: (Width: 640, Height: 520);
  Background: #1a0f2e(0.98);
  LayoutMode: Top;
  Padding: (Full: 24);

  Label {
    Text: "МЕНЮ СЕРВЕРА";
    Anchor: (Height: 46);
    Style: (FontSize: 30, TextColor: #e9d5ff, HorizontalAlignment: Center, RenderBold: true);
  }

  Group { Anchor: (Height: 2); Background: #6d28d9; }
  Group { Anchor: (Height: 28); }

  Group {
    Anchor: (Height: 74);
    LayoutMode: Center;

    TextButton #BtnRules {
      Text: "ПРАВИЛА";
      Anchor: (Width: 520, Height: 74);
      Style: @BigButtonStyle;
    }
  }

  Group { Anchor: (Height: 16); }

  Group {
    Anchor: (Height: 74);
    LayoutMode: Center;

    TextButton #BtnMinigames {
      Text: "МИНИ-ИГРЫ";
      Anchor: (Width: 520, Height: 74);
      Style: @BigButtonStyle;
    }
  }

  Group { Anchor: (Height: 16); }

  Group {
    Anchor: (Height: 74);
    LayoutMode: Center;

    TextButton #BtnDiscord {
      Text: "ДИСКОРД СЕРВЕР";
      Anchor: (Width: 520, Height: 74);
      Style: @BigButtonStyle;
    }
  }

  Group { FlexWeight: 1; }

  Group {
    Anchor: (Height: 46);
    LayoutMode: Center;

    TextButton #CloseButton {
      Text: "ЗАКРЫТЬ";
      Anchor: (Width: 200, Height: 46);
      Style: @CloseStyle;
    }
  }

  Group { Anchor: (Height: 8); }

  Label {
    Text: "ESC — закрыть меню";
    Anchor: (Height: 18);
    Style: (FontSize: 13, TextColor: #6b5a94, HorizontalAlignment: Center);
  }
}
