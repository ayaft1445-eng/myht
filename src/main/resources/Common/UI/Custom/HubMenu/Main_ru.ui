                  Style: (FontSize: 22, TextColor: #bfb2d9, HorizontalAlignment: Center, RenderBold: true);
                }
              }

              Group { Anchor: (Width: 2); Background: #3a2a55; }
            }

            Group { Anchor: (Height: 2); Background: #3a2a55; }
          }
          Group { Anchor: (Width: 14); }
          Group {
            Anchor: (Width: 240, Height: 470);
            LayoutMode: Top;

            Group { Anchor: (Height: 2); Background: #3a2a55; }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;

              Group { Anchor: (Width: 2); Background: #3a2a55; }

              Group {
