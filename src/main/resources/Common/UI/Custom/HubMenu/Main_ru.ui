                  Group { Anchor: (Height: 47); Background: #0e091a(0.5); }
                  Group { Anchor: (Height: 47); Background: #130b20(0.5); }
                  Group { Anchor: (Height: 47); Background: #170e27(0.5); }
                  Group { Anchor: (Height: 47); Background: #1c112d(0.5); }
                  Group { Anchor: (Height: 47); Background: #201334(0.5); }
                  Group { Anchor: (Height: 46); Background: #25163a(0.5); }
