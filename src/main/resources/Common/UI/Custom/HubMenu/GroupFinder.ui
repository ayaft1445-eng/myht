        Group { FlexWeight: 1; Background: #0f0f11(0.88); }
        Group { FlexWeight: 1; Background: #111114(0.88); }
        Group { FlexWeight: 1; Background: #131316(0.88); }
        Group { FlexWeight: 1; Background: #151518(0.88); }
        Group { FlexWeight: 1; Background: #17171a(0.88); }
      }

