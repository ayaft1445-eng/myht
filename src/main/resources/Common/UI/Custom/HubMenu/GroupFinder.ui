                Style: @Action;
              }
            }
          }
          Group { Anchor: (Width: 10); }
        }
        Group { Anchor: (Height: 6); }
        Group { FlexWeight: 1; }
        Group {
          Anchor: (Height: 52);
          LayoutMode: Left;
          Group { FlexWeight: 1; }
          Group {
            Anchor: (Width: 300, Height: 44);
            LayoutMode: Top;

            Group { Anchor: (Height: 2); Background: #3a3a3e; }

            Group {
