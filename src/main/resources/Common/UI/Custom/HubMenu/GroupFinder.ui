// Окно «Поиск группы». Текст строк проставляет сервер:
// #Status, #Name0..#Name5, #Info0..#Info5, #Join0..#Join5.
// Меняющийся текст сидит на TextButton: ID на Label клиент этой
// версии в рабочих окнах мода не встречает, проверять его на живых
// игроках нельзя — ошибка разбора не пускает на сервер.

@Action = TextButtonStyle(
  Default: (Background: #ffffff(0.06), LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #c8102e(0.60), LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #c8102e(0.85), LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@Flat = TextButtonStyle(
  Default: (Background: #ffffff(0.05), LabelStyle: (FontSize: 15, TextColor: #b8b8bd, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #c8102e(0.55), LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #c8102e(0.80), LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@Name = TextButtonStyle(
  Default: (Background: #ffffff(0.00), LabelStyle: (FontSize: 21, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #ffffff(0.00), LabelStyle: (FontSize: 21, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #ffffff(0.00), LabelStyle: (FontSize: 21, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@Dim = TextButtonStyle(
  Default: (Background: #ffffff(0.00), LabelStyle: (FontSize: 16, TextColor: #b8b8bd, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #ffffff(0.00), LabelStyle: (FontSize: 16, TextColor: #b8b8bd, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #ffffff(0.00), LabelStyle: (FontSize: 16, TextColor: #b8b8bd, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@Accent = TextButtonStyle(
  Default: (Background: #ffffff(0.00), LabelStyle: (FontSize: 17, TextColor: #c8102e, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #ffffff(0.00), LabelStyle: (FontSize: 17, TextColor: #c8102e, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #ffffff(0.00), LabelStyle: (FontSize: 17, TextColor: #c8102e, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

Group {
  Anchor: (Width: 1240, Height: 700);
  LayoutMode: Top;

  Group { Anchor: (Height: 2); Background: #3a3a3e; }

  Group {
    FlexWeight: 1;
    LayoutMode: Left;

    Group { Anchor: (Width: 2); Background: #3a3a3e; }

    Group {
      FlexWeight: 1;

      Group {
        Anchor: (Full: 0);
        LayoutMode: Top;

        Group { FlexWeight: 1; Background: #0b0b0c(0.88); }
