            }
          }
        }
        Group { FlexWeight: 1; }
        }
        Group { Anchor: (Height: 6); }
        Group {
          Anchor: (Height: 54);
          LayoutMode: Left;
          Background: #ffffff(0.03);
        Group { Anchor: (Width: 12); }
        Group {
          Anchor: (Width: 430, Height: 54);
          LayoutMode: Center;
          Label {
            Text: "КНОПКА В ОКНЕ «МИНИ-ИГРЫ»";
            Anchor: (Height: 34);
            Style: (FontSize: 17, TextColor: #b8b8bd, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
          }
        }
        Group {
          Anchor: (Width: 72, Height: 54);
          LayoutMode: Center;

          Group {
            Anchor: (Width: 60, Height: 40);

            TextButton #CardPrev {
              Text: "-";
              Anchor: (Full: 0);
              Style: @Flat;
            }
          }
        }
        Group {
          Anchor: (Width: 200, Height: 54);
          LayoutMode: Center;

          Group {
            Anchor: (Width: 188, Height: 40);

            TextButton #CardValue {
              Text: "нет";
              Anchor: (Full: 0);
              Style: @Value;
            }
          }
        }
        Group {
          Anchor: (Width: 72, Height: 54);
          LayoutMode: Center;

          Group {
            Anchor: (Width: 60, Height: 40);

            TextButton #CardNext {
              Text: "+";
              Anchor: (Full: 0);
              Style: @Flat;
            }
          }
        }
        Group { FlexWeight: 1; }
        }
        Group { Anchor: (Height: 12); }
        Group {
          Anchor: (Height: 68);
          LayoutMode: Left;
          Background: #ffffff(0.05);
        Group { Anchor: (Width: 12); }
        Group {
          Anchor: (Width: 230, Height: 68);
          LayoutMode: Center;
          Label {
            Text: "ТОЧКА ТЕЛЕПОРТА";
            Anchor: (Height: 34);
            Style: (FontSize: 17, TextColor: #b8b8bd, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
          }
        }
        Group {
          FlexWeight: 1;
          LayoutMode: Center;

          Group {
            Anchor: (Width: 20, Height: 54);

            TextButton #ArenaValue {
              Text: "не задана";
              Anchor: (Full: 0);
              Style: @Dim;
            }
          }
        }
        Group {
          Anchor: (Width: 300, Height: 68);
          LayoutMode: Center;

          Group {
            Anchor: (Width: 288, Height: 54);

            TextButton #SetHereButton {
              Text: "ПОСТАВИТЬ ТОЧКУ ЗДЕСЬ";
              Anchor: (Full: 0);
              Style: @Action;
            }
          }
        }
        Group {
          Anchor: (Width: 170, Height: 68);
          LayoutMode: Center;

          Group {
            Anchor: (Width: 158, Height: 54);

            TextButton #TestButton {
              Text: "ПРОВЕРИТЬ";
              Anchor: (Full: 0);
              Style: @Flat;
            }
          }
        }
        Group {
          Anchor: (Width: 160, Height: 68);
          LayoutMode: Center;

          Group {
            Anchor: (Width: 148, Height: 54);

            TextButton #ClearArenaButton {
              Text: "СБРОСИТЬ";
              Anchor: (Full: 0);
              Style: @Flat;
            }
          }
        }
        Group { Anchor: (Width: 12); }
        }
        Group { Anchor: (Height: 10); }
        Group {
          Anchor: (Height: 54);
          LayoutMode: Left;
          Background: #ffffff(0.03);
        Group { Anchor: (Width: 12); }
        Group {
          Anchor: (Width: 430, Height: 54);
          LayoutMode: Center;

          Group {
            Anchor: (Width: 418, Height: 40);

            TextButton #QueueValue {
              Text: "в очереди: 0";
              Anchor: (Full: 0);
              Style: @Dim;
            }
          }
        }
        Group {
          Anchor: (Width: 260, Height: 54);
          LayoutMode: Center;

          Group {
            Anchor: (Width: 248, Height: 40);

            TextButton #ClearQueueButton {
              Text: "ОЧИСТИТЬ ОЧЕРЕДЬ";
              Anchor: (Full: 0);
              Style: @Flat;
            }
          }
        }
        Group { FlexWeight: 1; }
        Group {
          Anchor: (Width: 220, Height: 54);
          LayoutMode: Center;

          Group {
            Anchor: (Width: 208, Height: 40);

            TextButton #DeleteButton {
              Text: "УДАЛИТЬ РЕЖИМ";
              Anchor: (Full: 0);
              Style: @Danger;
            }
          }
        }
        Group { Anchor: (Width: 12); }
        }
        Group { FlexWeight: 1; }
        Group {
          Anchor: (Height: 26);
          LayoutMode: Left;
        Group {
          FlexWeight: 1;
          LayoutMode: Center;

          Group {
            Anchor: (Width: 20, Height: 24);

            TextButton #Hint {
              Text: "";
              Anchor: (Full: 0);
              Style: @Dim;
            }
          }
        }
        }
        Group { Anchor: (Height: 6); }
        Label {
          Text: "ESC — ЗАКРЫТЬ";
          Anchor: (Height: 20);
          Style: (FontSize: 15, TextColor: #c8102e, HorizontalAlignment: Center, RenderBold: true);
        }
