            }
          }
        }
        Group {
          Anchor: (Width: 72, Height: 54);
          LayoutMode: Center;

          Group {
            Anchor: (Width: 60, Height: 40);

            TextButton #SpreadPlus {
              Text: "+";
              Anchor: (Full: 0);
