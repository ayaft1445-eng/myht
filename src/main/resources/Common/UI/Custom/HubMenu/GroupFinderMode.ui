        Group { Anchor: (Width: 12); }
        Group {
          Anchor: (Width: 430, Height: 54);
          LayoutMode: Center;
          Label {
            Text: "ОТСЧЁТ ПЕРЕД ТЕЛЕПОРТОМ, СЕК";
            Anchor: (Height: 34);
            Style: (FontSize: 17, TextColor: #b8b8bd, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
          }
        }
        Group {
          Anchor: (Width: 72, Height: 54);
          LayoutMode: Center;

          Group {
            Anchor: (Width: 60, Height: 40);

