// Окно настройки одного режима. Текст проставляет сервер:
// #Title, #EnabledValue, #MinValue, #MaxValue, #CdValue, #SpreadValue,
// #CardValue, #ArenaValue, #QueueValue, #Hint.

@Action = TextButtonStyle(
  Default: (Background: #ffffff(0.06), LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #c8102e(0.60), LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #c8102e(0.85), LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@Flat = TextButtonStyle(
  Default: (Background: #ffffff(0.05), LabelStyle: (FontSize: 15, TextColor: #b8b8bd, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #c8102e(0.55), LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #c8102e(0.80), LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@Danger = TextButtonStyle(
  Default: (Background: #c8102e(0.25), LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #c8102e(0.70), LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #c8102e(0.95), LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@Dim = TextButtonStyle(
  Default: (Background: #ffffff(0.00), LabelStyle: (FontSize: 16, TextColor: #b8b8bd, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #ffffff(0.00), LabelStyle: (FontSize: 16, TextColor: #b8b8bd, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #ffffff(0.00), LabelStyle: (FontSize: 16, TextColor: #b8b8bd, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@Value = TextButtonStyle(
  Default: (Background: #ffffff(0.00), LabelStyle: (FontSize: 21, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #ffffff(0.00), LabelStyle: (FontSize: 21, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #ffffff(0.00), LabelStyle: (FontSize: 21, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@Head = TextButtonStyle(
  Default: (Background: #ffffff(0.00), LabelStyle: (FontSize: 26, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #ffffff(0.00), LabelStyle: (FontSize: 26, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #ffffff(0.00), LabelStyle: (FontSize: 26, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

Group {
  Anchor: (Width: 1180, Height: 700);
  LayoutMode: Top;

  Group { Anchor: (Height: 2); Background: #3a3a3e; }

  Group {
    FlexWeight: 1;
    LayoutMode: Left;

    Group { Anchor: (Width: 2); Background: #3a3a3e; }

    Group {
      FlexWeight: 1;

      Group {
        Anchor: (Full: 0);
        LayoutMode: Top;

        Group { FlexWeight: 1; Background: #0b0b0c(0.92); }
        Group { FlexWeight: 1; Background: #0d0d0f(0.92); }
        Group { FlexWeight: 1; Background: #0f0f11(0.92); }
        Group { FlexWeight: 1; Background: #111114(0.92); }
        Group { FlexWeight: 1; Background: #131316(0.92); }
        Group { FlexWeight: 1; Background: #151518(0.92); }
        Group { FlexWeight: 1; Background: #17171a(0.92); }
      }

      Group {
        Anchor: (Full: 0);
        LayoutMode: Top;
        Padding: (Full: 22);

        Group {
          Anchor: (Height: 52);
          LayoutMode: Left;
        Group {
          Anchor: (Width: 160, Height: 44);
          LayoutMode: Top;

          Group { Anchor: (Height: 2); Background: #3a3a3e; }

          Group {
            FlexWeight: 1;
            LayoutMode: Left;

            Group { Anchor: (Width: 2); Background: #3a3a3e; }

            Group {
              FlexWeight: 1;

              TextButton #BackButton {
                Text: "НАЗАД";
                Anchor: (Full: 0);
                Style: @Flat;
              }
            }

            Group { Anchor: (Width: 2); Background: #3a3a3e; }
          }

          Group { Anchor: (Height: 2); Background: #3a3a3e; }
        }
        Group {
          FlexWeight: 1;
          LayoutMode: Center;

          Group {
            Anchor: (Width: 20, Height: 46);

            TextButton #Title {
              Text: "РЕЖИМ";
              Anchor: (Full: 0);
              Style: @Head;
            }
          }
        }
        Group { Anchor: (Width: 160); }
        }
        Group { Anchor: (Height: 2); Background: #c8102e; }
        Group { Anchor: (Height: 12); }
        Group {
          Anchor: (Height: 54);
          LayoutMode: Left;
          Background: #ffffff(0.03);
        Group { Anchor: (Width: 12); }
        Group {
          Anchor: (Width: 430, Height: 54);
          LayoutMode: Center;
          Label {
            Text: "СОСТОЯНИЕ";
            Anchor: (Height: 34);
            Style: (FontSize: 17, TextColor: #b8b8bd, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
          }
        }
        Group {
          Anchor: (Width: 270, Height: 54);
          LayoutMode: Center;

          Group {
            Anchor: (Width: 258, Height: 40);

            TextButton #EnabledValue {
              Text: "ВЫКЛЮЧЕН";
              Anchor: (Full: 0);
              Style: @Action;
            }
          }
        }
        Group { FlexWeight: 1; }
        }
        Group { Anchor: (Height: 6); }
        Group {
          Anchor: (Height: 54);
          LayoutMode: Left;
          Background: #ffffff(0.03);
        Group { Anchor: (Width: 12); }
        Group {
          Anchor: (Width: 430, Height: 54);
          LayoutMode: Center;
          Label {
            Text: "МИНИМУМ ИГРОКОВ ДЛЯ СТАРТА";
            Anchor: (Height: 34);
            Style: (FontSize: 17, TextColor: #b8b8bd, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
          }
        }
        Group {
          Anchor: (Width: 72, Height: 54);
          LayoutMode: Center;

          Group {
            Anchor: (Width: 60, Height: 40);

            TextButton #MinMinus {
              Text: "-";
              Anchor: (Full: 0);
              Style: @Flat;
            }
          }
        }
        Group {
          Anchor: (Width: 120, Height: 54);
          LayoutMode: Center;

          Group {
            Anchor: (Width: 108, Height: 40);

            TextButton #MinValue {
              Text: "2";
              Anchor: (Full: 0);
              Style: @Value;
            }
          }
        }
        Group {
          Anchor: (Width: 72, Height: 54);
          LayoutMode: Center;

          Group {
            Anchor: (Width: 60, Height: 40);

            TextButton #MinPlus {
              Text: "+";
              Anchor: (Full: 0);
              Style: @Flat;
            }
          }
        }
        Group { FlexWeight: 1; }
        }
        Group { Anchor: (Height: 6); }
        Group {
          Anchor: (Height: 54);
          LayoutMode: Left;
          Background: #ffffff(0.03);
        Group { Anchor: (Width: 12); }
        Group {
          Anchor: (Width: 430, Height: 54);
          LayoutMode: Center;
          Label {
            Text: "МАКСИМУМ ИГРОКОВ В ГРУППЕ";
            Anchor: (Height: 34);
            Style: (FontSize: 17, TextColor: #b8b8bd, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
