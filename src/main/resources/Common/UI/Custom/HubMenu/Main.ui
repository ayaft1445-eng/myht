// Главное окно HUB: четыре кнопки-карточки.
// Обводка — четыре белые полоски по краям (белой подложки под содержимым нет,
// иначе полупрозрачный чёрный выглядел бы серым).
// Ширина окна и карточек — в Anchor; прозрачность — число в скобках у цвета.

@Card = TextButtonStyle(
  Default: (Background: #000000(0.35), LabelStyle: (FontSize: 26, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #ffffff(0.18), LabelStyle: (FontSize: 26, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #ffffff(0.30), LabelStyle: (FontSize: 26, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

Group {
  Anchor: (Width: 1440, Height: 660);
  LayoutMode: Top;

  Group { Anchor: (Height: 2); Background: #ffffff; }

  Group {
    FlexWeight: 1;
    LayoutMode: Left;

    Group { Anchor: (Width: 2); Background: #ffffff; }

    Group {
      FlexWeight: 1;
      Background: #000000(0.55);
      LayoutMode: Top;
      Padding: (Full: 24);

      Label {
        Text: "HUB";
        Anchor: (Height: 60);
        Style: (FontSize: 44, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
      }

      Group { Anchor: (Height: 16); }

      Group {
        Anchor: (Height: 470);
        LayoutMode: Left;

        Group {
          Anchor: (Width: 440, Height: 470);
          LayoutMode: Top;

          Group { Anchor: (Height: 2); Background: #ffffff; }

          Group {
            FlexWeight: 1;
            LayoutMode: Left;

            Group { Anchor: (Width: 2); Background: #ffffff; }

            Group {
              FlexWeight: 1;

              TextButton #BtnMinigames {
                Text: "";
                Anchor: (Full: 0);
                Style: @Card;
              }

              Label {
                Text: "МИНИ-ИГРЫ";
                Anchor: (Height: 40, Bottom: 20);
                Style: (FontSize: 32, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
              }
            }

            Group { Anchor: (Width: 2); Background: #ffffff; }
          }

          Group { Anchor: (Height: 2); Background: #ffffff; }
        }
        Group { Anchor: (Width: 16); }
        Group {
          Anchor: (Width: 300, Height: 470);
          LayoutMode: Top;

          Group { Anchor: (Height: 2); Background: #ffffff; }

          Group {
            FlexWeight: 1;
            LayoutMode: Left;

            Group { Anchor: (Width: 2); Background: #ffffff; }

            Group {
              FlexWeight: 1;

              TextButton #BtnNews {
                Text: "";
                Anchor: (Full: 0);
                Style: @Card;
              }

              Label {
                Text: "НОВОСТИ";
                Anchor: (Height: 34, Bottom: 20);
                Style: (FontSize: 26, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
              }
            }

            Group { Anchor: (Width: 2); Background: #ffffff; }
          }

          Group { Anchor: (Height: 2); Background: #ffffff; }
        }
        Group { Anchor: (Width: 16); }
        Group {
          Anchor: (Width: 300, Height: 470);
          LayoutMode: Top;

          Group { Anchor: (Height: 2); Background: #ffffff; }

          Group {
            FlexWeight: 1;
            LayoutMode: Left;

            Group { Anchor: (Width: 2); Background: #ffffff; }

            Group {
              FlexWeight: 1;

              TextButton #BtnRules {
                Text: "";
                Anchor: (Full: 0);
                Style: @Card;
              }

              Label {
                Text: "ПРАВИЛА";
                Anchor: (Height: 34, Bottom: 20);
                Style: (FontSize: 26, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
              }
            }

            Group { Anchor: (Width: 2); Background: #ffffff; }
          }

          Group { Anchor: (Height: 2); Background: #ffffff; }
        }
        Group { Anchor: (Width: 16); }
        Group {
          Anchor: (Width: 300, Height: 470);
          LayoutMode: Top;

          Group { Anchor: (Height: 2); Background: #ffffff; }

          Group {
            FlexWeight: 1;
            LayoutMode: Left;

            Group { Anchor: (Width: 2); Background: #ffffff; }

            Group {
              FlexWeight: 1;

              TextButton #BtnDiscord {
                Text: "";
                Anchor: (Full: 0);
                Style: @Card;
              }

              Label {
                Text: "ДС СЕРВЕР";
                Anchor: (Height: 34, Bottom: 20);
                Style: (FontSize: 26, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
              }
            }

            Group { Anchor: (Width: 2); Background: #ffffff; }
          }

          Group { Anchor: (Height: 2); Background: #ffffff; }
        }
      }

      Group { Anchor: (Height: 14); }

      Label {
        Text: "ESC — закрыть меню";
        Anchor: (Height: 18);
        Style: (FontSize: 13, TextColor: #9a9a9a, HorizontalAlignment: Center);
      }
    }

    Group { Anchor: (Width: 2); Background: #ffffff; }
  }

  Group { Anchor: (Height: 2); Background: #ffffff; }
}
