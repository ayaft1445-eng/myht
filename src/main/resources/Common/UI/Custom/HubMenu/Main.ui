// Главное окно HUB в тёмно-фиолетовом стиле: почти чёрный фон с фиолетовым
// отливом и переходом книзу, тонкие фиолетовые рамки, белый капс, яркий
// фиолетовый акцент. Светлая рамка = выделенная карточка, тусклая = остальные.
// Палитра — в INSTALL-RU.md, прежний тёмно-красный вариант — в palettes/dark-red.

@Card = TextButtonStyle(
  Default: (Background: #c9b3ff(0.04), LabelStyle: (FontSize: 26, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #a35dff(0.16), LabelStyle: (FontSize: 26, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #a35dff(0.32), LabelStyle: (FontSize: 26, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@Flat = TextButtonStyle(
  Default: (Background: #c9b3ff(0.06), LabelStyle: (FontSize: 15, TextColor: #bfb2d9, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #a35dff(0.55), LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #a35dff(0.80), LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

Group {
  Anchor: (Width: 1440, Height: 660);
  LayoutMode: Top;

  Group { Anchor: (Height: 2); Background: #3a2a55; }

  Group {
    FlexWeight: 1;
    LayoutMode: Left;

    Group { Anchor: (Width: 2); Background: #3a2a55; }

    Group {
      FlexWeight: 1;

      Group {
        Anchor: (Full: 0);
        LayoutMode: Top;

        Group { FlexWeight: 1; Background: #0a0612(0.88); }
        Group { FlexWeight: 1; Background: #0c0715(0.88); }
        Group { FlexWeight: 1; Background: #0e0819(0.88); }
        Group { FlexWeight: 1; Background: #100a1c(0.88); }
        Group { FlexWeight: 1; Background: #120b20(0.88); }
        Group { FlexWeight: 1; Background: #140c23(0.88); }
        Group { FlexWeight: 1; Background: #160d27(0.88); }
        Group { FlexWeight: 1; Background: #180f2a(0.88); }
        Group { FlexWeight: 1; Background: #1a102e(0.88); }
        Group { FlexWeight: 1; Background: #1c1131(0.88); }
      }

      Group {
        Anchor: (Full: 0);
        LayoutMode: Top;
        Padding: (Full: 24);

        Label {
          Text: "HUB";
          Anchor: (Height: 54);
          Style: (FontSize: 44, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
        }

        Group { Anchor: (Height: 2); Background: #a35dff; }
        Group { Anchor: (Height: 14); }

        Group {
          Anchor: (Height: 470);
          LayoutMode: Left;

          Group {
            Anchor: (Width: 40);
            LayoutMode: Center;

            Label {
              Text: "<";
              Anchor: (Height: 44);
              Style: (FontSize: 34, TextColor: #6f6189, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
            }
          }
          Group { Anchor: (Width: 8); }
          Group {
            Anchor: (Width: 520, Height: 470);
            LayoutMode: Top;

            Group { Anchor: (Height: 2); Background: #d8c4ff; }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;

              Group { Anchor: (Width: 2); Background: #d8c4ff; }

              Group {
                FlexWeight: 1;

                Group {
                  Anchor: (Full: 0);
                  LayoutMode: Top;

                  Group { FlexWeight: 1; Background: #140c22(0.75); }
                  Group { FlexWeight: 1; Background: #160d25(0.75); }
                  Group { FlexWeight: 1; Background: #180f28(0.75); }
                  Group { FlexWeight: 1; Background: #1b102c(0.75); }
                  Group { FlexWeight: 1; Background: #1d112f(0.75); }
                  Group { FlexWeight: 1; Background: #1f1332(0.75); }
                  Group { FlexWeight: 1; Background: #211435(0.75); }
                  Group { FlexWeight: 1; Background: #241539(0.75); }
                  Group { FlexWeight: 1; Background: #26173c(0.75); }
                  Group { FlexWeight: 1; Background: #28183f(0.75); }
                }
                TextButton #BtnMinigames {
                  Text: "";
                  Anchor: (Full: 0);
                  Style: @Card;
                }

                Label {
                  Text: "МИНИ-ИГРЫ";
                  Anchor: (Height: 38, Bottom: 22);
                  Style: (FontSize: 30, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
                }
              }

              Group { Anchor: (Width: 2); Background: #d8c4ff; }
            }

            Group { Anchor: (Height: 2); Background: #d8c4ff; }
          }
          Group { Anchor: (Width: 14); }
          Group {
            Anchor: (Width: 240, Height: 470);
            LayoutMode: Top;

            Group { Anchor: (Height: 2); Background: #3a2a55; }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;

              Group { Anchor: (Width: 2); Background: #3a2a55; }

              Group {
                FlexWeight: 1;

                Group {
                  Anchor: (Full: 0);
                  LayoutMode: Top;

                  Group { FlexWeight: 1; Background: #140c22(0.75); }
                  Group { FlexWeight: 1; Background: #160d25(0.75); }
                  Group { FlexWeight: 1; Background: #180f28(0.75); }
                  Group { FlexWeight: 1; Background: #1b102c(0.75); }
                  Group { FlexWeight: 1; Background: #1d112f(0.75); }
                  Group { FlexWeight: 1; Background: #1f1332(0.75); }
                  Group { FlexWeight: 1; Background: #211435(0.75); }
                  Group { FlexWeight: 1; Background: #241539(0.75); }
                  Group { FlexWeight: 1; Background: #26173c(0.75); }
                  Group { FlexWeight: 1; Background: #28183f(0.75); }
                }
                TextButton #BtnNews {
                  Text: "";
                  Anchor: (Full: 0);
                  Style: @Card;
                }

                Label {
                  Text: "НОВОСТИ";
                  Anchor: (Height: 30, Bottom: 22);
                  Style: (FontSize: 22, TextColor: #bfb2d9, HorizontalAlignment: Center, RenderBold: true);
                }
              }

              Group { Anchor: (Width: 2); Background: #3a2a55; }
            }

            Group { Anchor: (Height: 2); Background: #3a2a55; }
          }
          Group { Anchor: (Width: 14); }
          Group {
            Anchor: (Width: 240, Height: 470);
            LayoutMode: Top;

            Group { Anchor: (Height: 2); Background: #3a2a55; }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;

              Group { Anchor: (Width: 2); Background: #3a2a55; }

              Group {
                FlexWeight: 1;

                Group {
                  Anchor: (Full: 0);
                  LayoutMode: Top;

                  Group { FlexWeight: 1; Background: #140c22(0.75); }
                  Group { FlexWeight: 1; Background: #160d25(0.75); }
                  Group { FlexWeight: 1; Background: #180f28(0.75); }
                  Group { FlexWeight: 1; Background: #1b102c(0.75); }
                  Group { FlexWeight: 1; Background: #1d112f(0.75); }
                  Group { FlexWeight: 1; Background: #1f1332(0.75); }
                  Group { FlexWeight: 1; Background: #211435(0.75); }
                  Group { FlexWeight: 1; Background: #241539(0.75); }
                  Group { FlexWeight: 1; Background: #26173c(0.75); }
                  Group { FlexWeight: 1; Background: #28183f(0.75); }
                }
                TextButton #BtnRules {
                  Text: "";
                  Anchor: (Full: 0);
                  Style: @Card;
                }

                Label {
                  Text: "ПРАВИЛА";
                  Anchor: (Height: 30, Bottom: 22);
                  Style: (FontSize: 22, TextColor: #bfb2d9, HorizontalAlignment: Center, RenderBold: true);
                }
              }

              Group { Anchor: (Width: 2); Background: #3a2a55; }
            }

            Group { Anchor: (Height: 2); Background: #3a2a55; }
          }
          Group { Anchor: (Width: 14); }
          Group {
            Anchor: (Width: 240, Height: 470);
            LayoutMode: Top;

            Group { Anchor: (Height: 2); Background: #3a2a55; }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;

              Group { Anchor: (Width: 2); Background: #3a2a55; }

              Group {
                FlexWeight: 1;

                Group {
                  Anchor: (Full: 0);
                  LayoutMode: Top;

                  Group { FlexWeight: 1; Background: #140c22(0.75); }
                  Group { FlexWeight: 1; Background: #160d25(0.75); }
                  Group { FlexWeight: 1; Background: #180f28(0.75); }
                  Group { FlexWeight: 1; Background: #1b102c(0.75); }
                  Group { FlexWeight: 1; Background: #1d112f(0.75); }
                  Group { FlexWeight: 1; Background: #1f1332(0.75); }
                  Group { FlexWeight: 1; Background: #211435(0.75); }
                  Group { FlexWeight: 1; Background: #241539(0.75); }
                  Group { FlexWeight: 1; Background: #26173c(0.75); }
                  Group { FlexWeight: 1; Background: #28183f(0.75); }
                }
                TextButton #BtnDiscord {
                  Text: "";
                  Anchor: (Full: 0);
                  Style: @Card;
                }

                Label {
                  Text: "ДС СЕРВЕР";
                  Anchor: (Height: 30, Bottom: 22);
                  Style: (FontSize: 22, TextColor: #bfb2d9, HorizontalAlignment: Center, RenderBold: true);
                }
              }

              Group { Anchor: (Width: 2); Background: #3a2a55; }
            }

            Group { Anchor: (Height: 2); Background: #3a2a55; }
          }
          Group { Anchor: (Width: 8); }
          Group {
            Anchor: (Width: 40);
            LayoutMode: Center;

            Label {
              Text: ">";
              Anchor: (Height: 44);
              Style: (FontSize: 34, TextColor: #6f6189, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
            }
          }
        }

        Group { Anchor: (Height: 14); }

        Label {
          Text: "ESC — ЗАКРЫТЬ";
          Anchor: (Height: 20);
          Style: (FontSize: 15, TextColor: #a35dff, HorizontalAlignment: Center, RenderBold: true);
        }
      }
    }

    Group { Anchor: (Width: 2); Background: #3a2a55; }
  }

  Group { Anchor: (Height: 2); Background: #3a2a55; }
}
