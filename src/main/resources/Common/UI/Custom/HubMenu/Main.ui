// Главное окно HUB: четыре кнопки-карточки.
// Обводка сделана четырьмя белыми полосками по краям, а не белой заливкой —
// иначе полупрозрачный чёрный смешивался бы с белым и выглядел серым.
// Прозрачность — число в скобках у цвета: меньше значит прозрачнее.

@Card = TextButtonStyle(
  Default: (Background: #000000(0.35), LabelStyle: (FontSize: 24, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #ffffff(0.18), LabelStyle: (FontSize: 24, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #ffffff(0.30), LabelStyle: (FontSize: 24, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@Flat = TextButtonStyle(
  Default: (Background: #000000(0.35), LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #ffffff(0.18), LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #ffffff(0.30), LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

Group {
  Anchor: (Width: 1280, Height: 620);
  LayoutMode: Top;

  Group { Anchor: (Height: 2); Background: #ffffff; }

  Group {
    FlexWeight: 1;
    LayoutMode: Left;

    Group { Anchor: (Width: 2); Background: #ffffff; }

    Group {
      FlexWeight: 1;
      Background: #000000(0.55);
      LayoutMode: Top;
      Padding: (Full: 24);

      Label {
        Text: "HUB";
        Anchor: (Height: 60);
        Style: (FontSize: 44, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
      }

      Group { Anchor: (Height: 16); }

      Group {
        Anchor: (Height: 450);
        LayoutMode: Left;

        Group {
          Anchor: (Width: 382, Height: 450);
          LayoutMode: Top;

          Group { Anchor: (Height: 2); Background: #ffffff; }

          Group {
            FlexWeight: 1;
            LayoutMode: Left;

            Group { Anchor: (Width: 2); Background: #ffffff; }

            Group {
              FlexWeight: 1;

              TextButton #BtnMinigames {
                Text: "";
                Anchor: (Full: 0);
                Style: @Card;
              }

              Label {
                Text: "МИНИ-ИГРЫ";
                Anchor: (Height: 36, Bottom: 20);
                Style: (FontSize: 28, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
              }
            }

            Group { Anchor: (Width: 2); Background: #ffffff; }
          }

          Group { Anchor: (Height: 2); Background: #ffffff; }
        }
        Group { Anchor: (Width: 16); }
        Group {
          Anchor: (Width: 266, Height: 450);
          LayoutMode: Top;

          Group { Anchor: (Height: 2); Background: #ffffff; }

          Group {
            FlexWeight: 1;
            LayoutMode: Left;

            Group { Anchor: (Width: 2); Background: #ffffff; }

            Group {
              FlexWeight: 1;

              TextButton #BtnNews {
                Text: "";
                Anchor: (Full: 0);
                Style: @Card;
              }

              Label {
                Text: "НОВОСТИ";
                Anchor: (Height: 32, Bottom: 20);
                Style: (FontSize: 24, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
              }
            }

            Group { Anchor: (Width: 2); Background: #ffffff; }
          }

          Group { Anchor: (Height: 2); Background: #ffffff; }
        }
        Group { Anchor: (Width: 16); }
        Group {
          Anchor: (Width: 266, Height: 450);
          LayoutMode: Top;

          Group { Anchor: (Height: 2); Background: #ffffff; }

          Group {
            FlexWeight: 1;
            LayoutMode: Left;

            Group { Anchor: (Width: 2); Background: #ffffff; }

            Group {
              FlexWeight: 1;

              TextButton #BtnRules {
                Text: "";
                Anchor: (Full: 0);
                Style: @Card;
              }

              Label {
                Text: "ПРАВИЛА";
                Anchor: (Height: 32, Bottom: 20);
                Style: (FontSize: 24, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
              }
            }

            Group { Anchor: (Width: 2); Background: #ffffff; }
          }

          Group { Anchor: (Height: 2); Background: #ffffff; }
        }
        Group { Anchor: (Width: 16); }
        Group {
          Anchor: (Width: 266, Height: 450);
          LayoutMode: Top;

          Group { Anchor: (Height: 2); Background: #ffffff; }

          Group {
            FlexWeight: 1;
            LayoutMode: Left;

            Group { Anchor: (Width: 2); Background: #ffffff; }

            Group {
              FlexWeight: 1;

              TextButton #BtnDiscord {
                Text: "";
                Anchor: (Full: 0);
                Style: @Card;
              }

              Label {
                Text: "ДС СЕРВЕР";
                Anchor: (Height: 32, Bottom: 20);
                Style: (FontSize: 24, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
              }
            }

            Group { Anchor: (Width: 2); Background: #ffffff; }
          }

          Group { Anchor: (Height: 2); Background: #ffffff; }
        }
      }

      Group { Anchor: (Height: 16); }


      Label {
        Text: "ESC — закрыть меню";
        Anchor: (Height: 18);
        Style: (FontSize: 13, TextColor: #9a9a9a, HorizontalAlignment: Center);
      }
    }

    Group { Anchor: (Width: 2); Background: #ffffff; }
  }

  Group { Anchor: (Height: 2); Background: #ffffff; }
}
