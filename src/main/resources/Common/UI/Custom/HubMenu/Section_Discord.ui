// Окно «ДС сервер». Ссылку меняй и здесь, и в HubMenuPage.java (строка DISCORD_LINK).

@Flat = TextButtonStyle(
  Default: (Background: #000000(0.35), LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #ffffff(0.18), LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #ffffff(0.30), LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

Group {
  Anchor: (Width: 1440, Height: 660);
  LayoutMode: Top;

  Group { Anchor: (Height: 2); Background: #ffffff; }

  Group {
    FlexWeight: 1;
    LayoutMode: Left;

    Group { Anchor: (Width: 2); Background: #ffffff; }

    Group {
      FlexWeight: 1;
      Background: #000000(0.55);
      LayoutMode: Top;
      Padding: (Full: 24);

      Group {
        Anchor: (Height: 56);
        LayoutMode: Left;

          Group {
            Anchor: (Width: 160, Height: 44);
            LayoutMode: Top;

            Group { Anchor: (Height: 2); Background: #ffffff; }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;

              Group { Anchor: (Width: 2); Background: #ffffff; }

              Group {
                FlexWeight: 1;

                TextButton #BackButton {
                  Text: "НАЗАД";
                  Anchor: (Full: 0);
                  Style: @Flat;
                }
              }

              Group { Anchor: (Width: 2); Background: #ffffff; }
            }

            Group { Anchor: (Height: 2); Background: #ffffff; }
          }

          Group {
            FlexWeight: 1;
            LayoutMode: Center;

            Label {
              Text: "ДС СЕРВЕР";
              Anchor: (Height: 48);
              Style: (FontSize: 36, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
            }
          }

          Group { Anchor: (Width: 160); }
      }

      Group { Anchor: (Height: 2); Background: #ffffff; }
      Group { Anchor: (Height: 18); }

      Group {
        FlexWeight: 1;
        LayoutMode: Top;

        Group { Anchor: (Height: 2); Background: #ffffff; }

        Group {
          FlexWeight: 1;
          LayoutMode: Left;

          Group { Anchor: (Width: 2); Background: #ffffff; }

          Group {
            FlexWeight: 1;
            Background: #000000(0.35);
            LayoutMode: Top;
            Padding: (Full: 24);

            Group { FlexWeight: 1; }

            Label {
              Text: "Наш Discord-сервер";
              Anchor: (Height: 34);
              Style: (FontSize: 24, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
            }

            Group { Anchor: (Height: 12); }

            Label {
              Text: "discord.gg/ЗАМЕНИ-НА-СВОЮ-ССЫЛКУ";
              Anchor: (Height: 32);
              Style: (FontSize: 22, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
            }

            Group { Anchor: (Height: 20); }

            Group {
              Anchor: (Height: 48);
              LayoutMode: Center;

              Group {
                Anchor: (Width: 300, Height: 48);
                LayoutMode: Top;

                Group { Anchor: (Height: 2); Background: #ffffff; }

                Group {
                  FlexWeight: 1;
                  LayoutMode: Left;

                  Group { Anchor: (Width: 2); Background: #ffffff; }

                  Group {
                    FlexWeight: 1;

                    TextButton #DiscordButton {
                      Text: "ПОЛУЧИТЬ ССЫЛКУ";
                      Anchor: (Full: 0);
                      Style: @Flat;
                    }
                  }

                  Group { Anchor: (Width: 2); Background: #ffffff; }
                }

                Group { Anchor: (Height: 2); Background: #ffffff; }
              }
            }

            Group { Anchor: (Height: 12); }

            Label {
              Text: "Нажми кнопку — ссылка придёт в чат, оттуда её можно скопировать.";
              Anchor: (Height: 22);
              Style: (FontSize: 14, TextColor: #9a9a9a, HorizontalAlignment: Center);
            }

            Group { FlexWeight: 1; }
          }

          Group { Anchor: (Width: 2); Background: #ffffff; }
        }

        Group { Anchor: (Height: 2); Background: #ffffff; }
      }

      Group { Anchor: (Height: 14); }

      Label {
        Text: "ESC — закрыть меню";
        Anchor: (Height: 18);
        Style: (FontSize: 13, TextColor: #9a9a9a, HorizontalAlignment: Center);
      }
    }

    Group { Anchor: (Width: 2); Background: #ffffff; }
  }

  Group { Anchor: (Height: 2); Background: #ffffff; }
}
