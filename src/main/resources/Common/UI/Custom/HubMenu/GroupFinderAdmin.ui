            }

            Group { Anchor: (Height: 2); Background: #3a3a3e; }
          }
        }
        Group { Anchor: (Height: 2); Background: #c8102e; }
        Group { Anchor: (Height: 10); }
        Label #Banner {
          Text: "";
          Anchor: (Height: 26);
          Style: (FontSize: 16, TextColor: #c8102e, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
        }
        Group { Anchor: (Height: 8); }
        Group {
          Anchor: (Height: 58);
          LayoutMode: Left;
          Background: #ffffff(0.03);
          Group { Anchor: (Width: 12); }
          Group {
            Anchor: (Width: 140, Height: 58);
            LayoutMode: Center;

            Label {
              Text: "СИСТЕМА";
              Anchor: (Height: 34);
              Style: (FontSize: 16, TextColor: #6e6e74, HorizontalAlignment: Left, VerticalAlignment: Center, RenderBold: true);
            }
          }
          Group {
