// Окно «Новости». Текст новостей — в строках Text ниже.

@Flat = TextButtonStyle(
  Default: (Background: #000000(0.35), LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #ffffff(0.18), LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #ffffff(0.30), LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

Group {
  Anchor: (Width: 1440, Height: 660);
  LayoutMode: Top;

  Group { Anchor: (Height: 2); Background: #ffffff; }

  Group {
    FlexWeight: 1;
    LayoutMode: Left;

    Group { Anchor: (Width: 2); Background: #ffffff; }

    Group {
      FlexWeight: 1;
      Background: #000000(0.55);
      LayoutMode: Top;
      Padding: (Full: 24);

      Group {
        Anchor: (Height: 56);
        LayoutMode: Left;

          Group {
            Anchor: (Width: 160, Height: 44);
            LayoutMode: Top;

            Group { Anchor: (Height: 2); Background: #ffffff; }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;

              Group { Anchor: (Width: 2); Background: #ffffff; }

              Group {
                FlexWeight: 1;

                TextButton #BackButton {
                  Text: "НАЗАД";
                  Anchor: (Full: 0);
                  Style: @Flat;
                }
              }

              Group { Anchor: (Width: 2); Background: #ffffff; }
            }

            Group { Anchor: (Height: 2); Background: #ffffff; }
          }

          Group {
            FlexWeight: 1;
            LayoutMode: Center;

            Label {
              Text: "НОВОСТИ";
              Anchor: (Height: 48);
              Style: (FontSize: 36, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
            }
          }

          Group { Anchor: (Width: 160); }
      }

      Group { Anchor: (Height: 2); Background: #ffffff; }
      Group { Anchor: (Height: 18); }

      Group {
        FlexWeight: 1;
        LayoutMode: Top;

        Group { Anchor: (Height: 2); Background: #ffffff; }

        Group {
          FlexWeight: 1;
          LayoutMode: Left;

          Group { Anchor: (Width: 2); Background: #ffffff; }

          Group {
            FlexWeight: 1;
            Background: #000000(0.35);
            LayoutMode: Top;
            Padding: (Full: 24);

                Label {
                  Text: "ОТКРЫТИЕ СЕРВЕРА";
                  Anchor: (Height: 32);
                  Style: (FontSize: 22, TextColor: #ffffff, RenderBold: true);
                }
                Label {
                  Text: "Мы запустились! Заходите, зовите друзей";
                  Anchor: (Height: 24);
                  Style: (FontSize: 16, TextColor: #d0d0d0);
                }
                Label {
                  Text: "и пишите о багах в Discord.";
                  Anchor: (Height: 24);
                  Style: (FontSize: 16, TextColor: #d0d0d0);
                }
                Group { Anchor: (Height: 18); }
                Label {
                  Text: "НОВАЯ МИНИ-ИГРА";
                  Anchor: (Height: 32);
                  Style: (FontSize: 22, TextColor: #ffffff, RenderBold: true);
                }
                Label {
                  Text: "Скоро добавим «Захват флага»:";
                  Anchor: (Height: 24);
                  Style: (FontSize: 16, TextColor: #d0d0d0);
                }
                Label {
                  Text: "две команды, один флаг, много шума.";
                  Anchor: (Height: 24);
                  Style: (FontSize: 16, TextColor: #d0d0d0);
                }
                Group { Anchor: (Height: 18); }
                Label {
                  Text: "ОБНОВЛЕНИЕ МИРА";
                  Anchor: (Height: 32);
                  Style: (FontSize: 22, TextColor: #ffffff, RenderBold: true);
                }
                Label {
                  Text: "Спавн перестроен, добавлены порталы";
                  Anchor: (Height: 24);
                  Style: (FontSize: 16, TextColor: #d0d0d0);
                }
                Label {
                  Text: "к аренам и торговой площади.";
                  Anchor: (Height: 24);
                  Style: (FontSize: 16, TextColor: #d0d0d0);
                }
                Group { Anchor: (Height: 18); }
          }

          Group { Anchor: (Width: 2); Background: #ffffff; }
        }

        Group { Anchor: (Height: 2); Background: #ffffff; }
      }

      Group { Anchor: (Height: 14); }

      Label {
        Text: "ESC — закрыть меню";
        Anchor: (Height: 18);
        Style: (FontSize: 13, TextColor: #9a9a9a, HorizontalAlignment: Center);
      }
    }

    Group { Anchor: (Width: 2); Background: #ffffff; }
  }

  Group { Anchor: (Height: 2); Background: #ffffff; }
}
