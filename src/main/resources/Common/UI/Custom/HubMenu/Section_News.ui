// Окно раздела «Новости». Текст новостей меняется в строках Text.

@Flat = TextButtonStyle(
  Default: (Background: #000000, LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #ffffff, LabelStyle: (FontSize: 16, TextColor: #000000, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #bbbbbb, LabelStyle: (FontSize: 16, TextColor: #000000, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

Group {
  Anchor: (Width: 1000, Height: 620);
  Background: #ffffff;
  Padding: (Full: 2);

  Group {
    Anchor: (Full: 0);
    Background: #000000;
    LayoutMode: Top;
    Padding: (Full: 24);

    Label {
      Text: "НОВОСТИ";
      Anchor: (Height: 56);
      Style: (FontSize: 36, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
    }

    Group { Anchor: (Height: 2); Background: #ffffff; }
    Group { Anchor: (Height: 16); }

  Group {
    FlexWeight: 1;
    Background: #ffffff;
    Padding: (Full: 2);

    Group {
      FlexWeight: 1;
      Background: #000000;
      LayoutMode: Top;
      Padding: (Full: 20);

      Group {
        Anchor: (Height: 90);
        LayoutMode: Left;

        Group {
          Anchor: (Width: 80, Height: 80);
          Background: #ffffff;
          Padding: (Full: 2);

          Group {
            Anchor: (Full: 0);
            Background: #000000;
            LayoutMode: Center;

            Label {
              Text: "ИКОНКА";
              Anchor: (Height: 16);
              Style: (FontSize: 11, TextColor: #888888, HorizontalAlignment: Center, VerticalAlignment: Center);
            }
          }
        }
        Group { Anchor: (Width: 16); }

        Group {
          FlexWeight: 1;
          LayoutMode: Top;

          Label {
            Text: "ОТКРЫТИЕ СЕРВЕРА";
            Anchor: (Height: 28);
            Style: (FontSize: 20, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Start);
          }
          Group { Anchor: (Height: 6); }
          Label {
            Text: "Мы запустились! Заходите, зовите друзей";
            Anchor: (Height: 22);
            Style: (FontSize: 15, TextColor: #bbbbbb, RenderBold: false, HorizontalAlignment: Start);
          }
          Label {
            Text: "и пишите о багах в Discord.";
            Anchor: (Height: 22);
            Style: (FontSize: 15, TextColor: #bbbbbb, RenderBold: false, HorizontalAlignment: Start);
          }
        }
      }
      Group { Anchor: (Height: 14); }
      Group {
        Anchor: (Height: 90);
        LayoutMode: Left;

        Group {
          Anchor: (Width: 80, Height: 80);
          Background: #ffffff;
          Padding: (Full: 2);

          Group {
            Anchor: (Full: 0);
            Background: #000000;
            LayoutMode: Center;

            Label {
              Text: "ИКОНКА";
              Anchor: (Height: 16);
              Style: (FontSize: 11, TextColor: #888888, HorizontalAlignment: Center, VerticalAlignment: Center);
            }
          }
        }
        Group { Anchor: (Width: 16); }

        Group {
          FlexWeight: 1;
          LayoutMode: Top;

          Label {
            Text: "НОВАЯ МИНИ-ИГРА";
            Anchor: (Height: 28);
            Style: (FontSize: 20, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Start);
          }
          Group { Anchor: (Height: 6); }
          Label {
            Text: "Скоро добавим «Захват флага»:";
            Anchor: (Height: 22);
            Style: (FontSize: 15, TextColor: #bbbbbb, RenderBold: false, HorizontalAlignment: Start);
          }
          Label {
            Text: "две команды, один флаг, много шума.";
            Anchor: (Height: 22);
            Style: (FontSize: 15, TextColor: #bbbbbb, RenderBold: false, HorizontalAlignment: Start);
          }
        }
      }
      Group { Anchor: (Height: 14); }
      Group {
        Anchor: (Height: 90);
        LayoutMode: Left;

        Group {
          Anchor: (Width: 80, Height: 80);
          Background: #ffffff;
          Padding: (Full: 2);

          Group {
            Anchor: (Full: 0);
            Background: #000000;
            LayoutMode: Center;

            Label {
              Text: "ИКОНКА";
              Anchor: (Height: 16);
              Style: (FontSize: 11, TextColor: #888888, HorizontalAlignment: Center, VerticalAlignment: Center);
            }
          }
        }
        Group { Anchor: (Width: 16); }

        Group {
          FlexWeight: 1;
          LayoutMode: Top;

          Label {
            Text: "ОБНОВЛЕНИЕ МИРА";
            Anchor: (Height: 28);
            Style: (FontSize: 20, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Start);
          }
          Group { Anchor: (Height: 6); }
          Label {
            Text: "Спавн перестроен, добавлены порталы";
            Anchor: (Height: 22);
            Style: (FontSize: 15, TextColor: #bbbbbb, RenderBold: false, HorizontalAlignment: Start);
          }
          Label {
            Text: "к аренам и торговой площади.";
            Anchor: (Height: 22);
            Style: (FontSize: 15, TextColor: #bbbbbb, RenderBold: false, HorizontalAlignment: Start);
          }
        }
      }
    }
  }

    Group { Anchor: (Height: 16); }

    Group {
      Anchor: (Height: 46);
      LayoutMode: Center;

      Group {
        Anchor: (Width: 220, Height: 46);
        Background: #ffffff;
        Padding: (Full: 2);

        TextButton #BackButton {
          Text: "НАЗАД";
          Anchor: (Full: 0);
          Style: @Flat;
        }
      }

      Group { Anchor: (Width: 16); }

      Group {
        Anchor: (Width: 220, Height: 46);
        Background: #ffffff;
        Padding: (Full: 2);

        TextButton #CloseButton {
          Text: "ЗАКРЫТЬ";
          Anchor: (Full: 0);
          Style: @Flat;
        }
      }
    }

    Group { Anchor: (Height: 8); }

    Label {
      Text: "ESC — закрыть меню";
      Anchor: (Height: 18);
      Style: (FontSize: 13, TextColor: #888888, HorizontalAlignment: Center);
    }
  }
}
