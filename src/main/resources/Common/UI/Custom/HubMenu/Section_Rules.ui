// Окно раздела «Правила». Текст правил — в строках Text ниже.

@Flat = TextButtonStyle(
  Default: (Background: #000000(0.35), LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #ffffff(0.18), LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #ffffff(0.30), LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

Group {
  Anchor: (Width: 1280, Height: 620);
  LayoutMode: Top;

  Group { Anchor: (Height: 2); Background: #ffffff; }

  Group {
    FlexWeight: 1;
    LayoutMode: Left;

    Group { Anchor: (Width: 2); Background: #ffffff; }

    Group {
      FlexWeight: 1;
      Background: #000000(0.55);
      LayoutMode: Top;
      Padding: (Full: 24);

      Label {
        Text: "ПРАВИЛА";
        Anchor: (Height: 56);
        Style: (FontSize: 36, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
      }

      Group { Anchor: (Height: 2); Background: #ffffff; }
      Group { Anchor: (Height: 16); }

      Group {
        FlexWeight: 1;
        LayoutMode: Top;

        Group { Anchor: (Height: 2); Background: #ffffff; }

        Group {
          FlexWeight: 1;
          LayoutMode: Left;

          Group { Anchor: (Width: 2); Background: #ffffff; }

          Group {
            FlexWeight: 1;
            Background: #000000(0.35);
            LayoutMode: Top;
            Padding: (Full: 20);

                Label {
                  Text: "1. Уважай других игроков: без оскорблений и токсичности.";
                  Anchor: (Height: 26);
                  Style: (FontSize: 16, TextColor: #ffffff);
                }
                Group { Anchor: (Height: 10); }
                Label {
                  Text: "2. Читы, багоюз и сторонние программы запрещены.";
                  Anchor: (Height: 26);
                  Style: (FontSize: 16, TextColor: #ffffff);
                }
                Group { Anchor: (Height: 10); }
                Label {
                  Text: "3. Не ломай и не забирай чужие постройки и вещи.";
                  Anchor: (Height: 26);
                  Style: (FontSize: 16, TextColor: #ffffff);
                }
                Group { Anchor: (Height: 10); }
                Label {
                  Text: "4. Реклама других серверов запрещена.";
                  Anchor: (Height: 26);
                  Style: (FontSize: 16, TextColor: #ffffff);
                }
                Group { Anchor: (Height: 10); }
                Label {
                  Text: "5. Решение администрации окончательное.";
                  Anchor: (Height: 26);
                  Style: (FontSize: 16, TextColor: #ffffff);
                }
                Group { Anchor: (Height: 10); }
                Group { Anchor: (Height: 10); }
                Label {
                  Text: "Это текст-заглушка — замени на свои правила.";
                  Anchor: (Height: 20);
                  Style: (FontSize: 13, TextColor: #9a9a9a);
                }
          }

          Group { Anchor: (Width: 2); Background: #ffffff; }
        }

        Group { Anchor: (Height: 2); Background: #ffffff; }
      }

      Group { Anchor: (Height: 16); }

      Group {
        Anchor: (Height: 46);
        LayoutMode: Center;

          Group {
            Anchor: (Width: 220, Height: 46);
            LayoutMode: Top;

            Group { Anchor: (Height: 2); Background: #ffffff; }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;

              Group { Anchor: (Width: 2); Background: #ffffff; }

              Group {
                FlexWeight: 1;

                TextButton #BackButton {
                  Text: "НАЗАД";
                  Anchor: (Full: 0);
                  Style: @Flat;
                }
              }

              Group { Anchor: (Width: 2); Background: #ffffff; }
            }

            Group { Anchor: (Height: 2); Background: #ffffff; }
          }

        Group { Anchor: (Width: 16); }

          Group {
            Anchor: (Width: 220, Height: 46);
            LayoutMode: Top;

            Group { Anchor: (Height: 2); Background: #ffffff; }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;

              Group { Anchor: (Width: 2); Background: #ffffff; }

              Group {
                FlexWeight: 1;

                TextButton #CloseButton {
                  Text: "ЗАКРЫТЬ";
                  Anchor: (Full: 0);
                  Style: @Flat;
                }
              }

              Group { Anchor: (Width: 2); Background: #ffffff; }
            }

            Group { Anchor: (Height: 2); Background: #ffffff; }
          }
      }

      Group { Anchor: (Height: 8); }

      Label {
        Text: "ESC — закрыть меню";
        Anchor: (Height: 18);
        Style: (FontSize: 13, TextColor: #9a9a9a, HorizontalAlignment: Center);
      }
    }

    Group { Anchor: (Width: 2); Background: #ffffff; }
  }

  Group { Anchor: (Height: 2); Background: #ffffff; }
}
