// Отдельное окно выбора языка. Показывается один раз — при первом заходе
// на сервер. Это не вкладка хаба: тут нет кнопки «Назад», окно меньше и просто
// закрывается после выбора. Подписи сразу на двух языках: язык ещё не выбран.
//
// Сменить язык потом можно карточкой «Язык» в меню /hub (Section_Language.ui).

@Lang = TextButtonStyle(
  Default: (Background: #c9b3ff(0.06), LabelStyle: (FontSize: 22, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #a35dff(0.45), LabelStyle: (FontSize: 22, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #a35dff(0.70), LabelStyle: (FontSize: 22, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

Group {
  Anchor: (Width: 760, Height: 420);
  LayoutMode: Top;

  Group { Anchor: (Height: 2); Background: #3a2a55; }

  Group {
    FlexWeight: 1;
    LayoutMode: Left;

    Group { Anchor: (Width: 2); Background: #3a2a55; }

    Group {
      FlexWeight: 1;

      // Фон окна — общая картинка со всеми окнами меню.
      Group { Anchor: (Full: 0); Background: #08050e; }
      Group { Anchor: (Full: 0); Background: (TexturePath: "Assets/Background.png"); }

      Group {
        Anchor: (Full: 0);
        LayoutMode: Top;
        Padding: (Full: 24);

        Group { Anchor: (Height: 44); }
        Label {
          Text: "ВЫБЕРИ ЯЗЫК";
          Anchor: (Height: 46);
          Style: (FontSize: 30, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
        }
        Group { Anchor: (Height: 10); }
        Label {
          Text: "CHOOSE YOUR LANGUAGE";
          Anchor: (Height: 26);
          Style: (FontSize: 17, TextColor: #bfb2d9, HorizontalAlignment: Center);
        }
        Group { Anchor: (Height: 2); Background: #a35dff; }
        Group { Anchor: (Height: 34); }
        Group {
          Anchor: (Height: 68);
          LayoutMode: Center;

          Group {
            Anchor: (Width: 360, Height: 68);
            LayoutMode: Top;

            Group { Anchor: (Height: 2); Background: #4a3768; }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;

              Group { Anchor: (Width: 2); Background: #4a3768; }

              Group {
                FlexWeight: 1;

                TextButton #LangRu {
                  Text: "РУССКИЙ";
                  Anchor: (Full: 0);
                  Style: @Lang;
                }
              }

              Group { Anchor: (Width: 2); Background: #4a3768; }
            }

            Group { Anchor: (Height: 2); Background: #4a3768; }
          }
        }
        Group { Anchor: (Height: 18); }
        Group {
          Anchor: (Height: 68);
          LayoutMode: Center;

          Group {
            Anchor: (Width: 360, Height: 68);
            LayoutMode: Top;

            Group { Anchor: (Height: 2); Background: #4a3768; }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;

              Group { Anchor: (Width: 2); Background: #4a3768; }

              Group {
                FlexWeight: 1;

                TextButton #LangEn {
                  Text: "ENGLISH";
                  Anchor: (Full: 0);
                  Style: @Lang;
                }
              }

              Group { Anchor: (Width: 2); Background: #4a3768; }
            }

            Group { Anchor: (Height: 2); Background: #4a3768; }
          }
        }
        Group { Anchor: (Height: 28); }
        Label {
          Text: "Сменить язык можно в меню /hub · You can change it later in /hub";
          Anchor: (Height: 24);
          Style: (FontSize: 15, TextColor: #6f6189, HorizontalAlignment: Center);
        }
      }
    }

    Group { Anchor: (Width: 2); Background: #3a2a55; }
  }

  Group { Anchor: (Height: 2); Background: #3a2a55; }
}
