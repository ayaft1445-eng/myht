// Окно «Мини-игры»: четыре карточки режимов. Название и описание — в строках Text.

@Card = TextButtonStyle(
  Default: (Background: #000000(0.35), LabelStyle: (FontSize: 22, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #ffffff(0.18), LabelStyle: (FontSize: 22, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #ffffff(0.30), LabelStyle: (FontSize: 22, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@Flat = TextButtonStyle(
  Default: (Background: #000000(0.35), LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #ffffff(0.18), LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #ffffff(0.30), LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

Group {
  Anchor: (Width: 1440, Height: 660);
  LayoutMode: Top;

  Group { Anchor: (Height: 2); Background: #ffffff; }

  Group {
    FlexWeight: 1;
    LayoutMode: Left;

    Group { Anchor: (Width: 2); Background: #ffffff; }

    Group {
      FlexWeight: 1;
      Background: #000000(0.55);
      LayoutMode: Top;
      Padding: (Full: 24);

      Group {
        Anchor: (Height: 56);
        LayoutMode: Left;

          Group {
            Anchor: (Width: 160, Height: 44);
            LayoutMode: Top;

            Group { Anchor: (Height: 2); Background: #ffffff; }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;

              Group { Anchor: (Width: 2); Background: #ffffff; }

              Group {
                FlexWeight: 1;

                TextButton #BackButton {
                  Text: "НАЗАД";
                  Anchor: (Full: 0);
                  Style: @Flat;
                }
              }

              Group { Anchor: (Width: 2); Background: #ffffff; }
            }

            Group { Anchor: (Height: 2); Background: #ffffff; }
          }

          Group {
            FlexWeight: 1;
            LayoutMode: Center;

            Label {
              Text: "МИНИ-ИГРЫ";
              Anchor: (Height: 48);
              Style: (FontSize: 36, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
            }
          }

          Group { Anchor: (Width: 160); }
      }

      Group { Anchor: (Height: 2); Background: #ffffff; }
      Group { Anchor: (Height: 18); }

      Group {
        Anchor: (Height: 420);
        LayoutMode: Left;

        Group {
          Anchor: (Width: 335, Height: 420);
          LayoutMode: Top;

          Group { Anchor: (Height: 2); Background: #ffffff; }

          Group {
            FlexWeight: 1;
            LayoutMode: Left;

            Group { Anchor: (Width: 2); Background: #ffffff; }

            Group {
              FlexWeight: 1;

              TextButton #Mode0 {
                Text: "";
                Anchor: (Full: 0);
                Style: @Card;
              }

              Label {
                Text: "ЗАХВАТ ФЛАГА";
                Anchor: (Height: 30, Bottom: 176);
                Style: (FontSize: 22, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
              }

              Label {
                Text: "Две команды, один флаг";
                Anchor: (Height: 24, Bottom: 138);
                Style: (FontSize: 15, TextColor: #d0d0d0, HorizontalAlignment: Center);
              }
            }

            Group { Anchor: (Width: 2); Background: #ffffff; }
          }

          Group { Anchor: (Height: 2); Background: #ffffff; }
        }
        Group { Anchor: (Width: 16); }
        Group {
          Anchor: (Width: 335, Height: 420);
          LayoutMode: Top;

          Group { Anchor: (Height: 2); Background: #ffffff; }

          Group {
            FlexWeight: 1;
            LayoutMode: Left;

            Group { Anchor: (Width: 2); Background: #ffffff; }

            Group {
              FlexWeight: 1;

              TextButton #Mode1 {
                Text: "";
                Anchor: (Full: 0);
                Style: @Card;
              }

              Label {
                Text: "ВЫЖИВАНИЕ";
                Anchor: (Height: 30, Bottom: 176);
                Style: (FontSize: 22, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
              }

              Label {
                Text: "Волны монстров";
                Anchor: (Height: 24, Bottom: 138);
                Style: (FontSize: 15, TextColor: #d0d0d0, HorizontalAlignment: Center);
              }
            }

            Group { Anchor: (Width: 2); Background: #ffffff; }
          }

          Group { Anchor: (Height: 2); Background: #ffffff; }
        }
        Group { Anchor: (Width: 16); }
        Group {
          Anchor: (Width: 335, Height: 420);
          LayoutMode: Top;

          Group { Anchor: (Height: 2); Background: #ffffff; }

          Group {
            FlexWeight: 1;
            LayoutMode: Left;

            Group { Anchor: (Width: 2); Background: #ffffff; }

            Group {
              FlexWeight: 1;

              TextButton #Mode2 {
                Text: "";
                Anchor: (Full: 0);
                Style: @Card;
              }

              Label {
                Text: "ПАРКУР";
                Anchor: (Height: 30, Bottom: 176);
                Style: (FontSize: 22, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
              }

              Label {
                Text: "Трасса на время";
                Anchor: (Height: 24, Bottom: 138);
                Style: (FontSize: 15, TextColor: #d0d0d0, HorizontalAlignment: Center);
              }
            }

            Group { Anchor: (Width: 2); Background: #ffffff; }
          }

          Group { Anchor: (Height: 2); Background: #ffffff; }
        }
        Group { Anchor: (Width: 16); }
        Group {
          Anchor: (Width: 335, Height: 420);
          LayoutMode: Top;

          Group { Anchor: (Height: 2); Background: #ffffff; }

          Group {
            FlexWeight: 1;
            LayoutMode: Left;

            Group { Anchor: (Width: 2); Background: #ffffff; }

            Group {
              FlexWeight: 1;

              TextButton #Mode3 {
                Text: "";
                Anchor: (Full: 0);
                Style: @Card;
              }

              Label {
                Text: "АРЕНА";
                Anchor: (Height: 30, Bottom: 176);
                Style: (FontSize: 22, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
              }

              Label {
                Text: "Бои один на один";
                Anchor: (Height: 24, Bottom: 138);
                Style: (FontSize: 15, TextColor: #d0d0d0, HorizontalAlignment: Center);
              }
            }

            Group { Anchor: (Width: 2); Background: #ffffff; }
          }

          Group { Anchor: (Height: 2); Background: #ffffff; }
        }
      }

      Group { Anchor: (Height: 14); }

      Label {
        Text: "ESC — закрыть меню";
        Anchor: (Height: 18);
        Style: (FontSize: 13, TextColor: #9a9a9a, HorizontalAlignment: Center);
      }
    }

    Group { Anchor: (Width: 2); Background: #ffffff; }
  }

  Group { Anchor: (Height: 2); Background: #ffffff; }
}
