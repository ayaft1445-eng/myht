// Окно «Мини-игры»: карточки режимов. Название и две строки описания — в строках Text.

@Card = TextButtonStyle(
  Default: (Background: #4b1d7a(0.10), LabelStyle: (FontSize: 26, TextColor: #c8a2ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #9b5de5(0.28), LabelStyle: (FontSize: 26, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #c8a2ff(0.35), LabelStyle: (FontSize: 26, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@Flat = TextButtonStyle(
  Default: (Background: #4b1d7a(0.55), LabelStyle: (FontSize: 15, TextColor: #c8a2ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #6a2ba8(0.75), LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #9b5de5(0.60), LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

Group {
  Anchor: (Width: 1440, Height: 660);
  LayoutMode: Top;

  Group { Anchor: (Height: 2); Background: #9b5de5; }

  Group {
    FlexWeight: 1;
    LayoutMode: Left;

    Group { Anchor: (Width: 2); Background: #9b5de5; }

    Group {
      FlexWeight: 1;

      Group {
        Anchor: (Full: 0);
        LayoutMode: Top;

        Group { FlexWeight: 1; Background: #1a0b2e(0.72); }
        Group { FlexWeight: 1; Background: #1c0c31(0.72); }
        Group { FlexWeight: 1; Background: #1e0c34(0.72); }
        Group { FlexWeight: 1; Background: #1f0d37(0.72); }
        Group { FlexWeight: 1; Background: #210e3a(0.72); }
        Group { FlexWeight: 1; Background: #230e3d(0.72); }
        Group { FlexWeight: 1; Background: #250f41(0.72); }
        Group { FlexWeight: 1; Background: #270f44(0.72); }
        Group { FlexWeight: 1; Background: #291047(0.72); }
        Group { FlexWeight: 1; Background: #2a114a(0.72); }
        Group { FlexWeight: 1; Background: #2c114d(0.72); }
        Group { FlexWeight: 1; Background: #2e1250(0.72); }
      }

      Group {
        Anchor: (Full: 0);
        LayoutMode: Top;
        Padding: (Full: 24);

        Group {
          Anchor: (Height: 56);
          LayoutMode: Left;

            Group {
              Anchor: (Width: 160, Height: 44);
              LayoutMode: Top;

              Group { Anchor: (Height: 2); Background: #9b5de5; }

              Group {
                FlexWeight: 1;
                LayoutMode: Left;

                Group { Anchor: (Width: 2); Background: #9b5de5; }

                Group {
                  FlexWeight: 1;

                  TextButton #BackButton {
                    Text: "НАЗАД";
                    Anchor: (Full: 0);
                    Style: @Flat;
                  }
                }

                Group { Anchor: (Width: 2); Background: #9b5de5; }
              }

              Group { Anchor: (Height: 2); Background: #9b5de5; }
            }

            Group {
              FlexWeight: 1;
              LayoutMode: Center;

              Label {
                Text: "МИНИ-ИГРЫ";
                Anchor: (Height: 48);
                Style: (FontSize: 36, TextColor: #c8a2ff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
              }
            }

            Group { Anchor: (Width: 160); }
        }

        Group { Anchor: (Height: 2); Background: #9b5de5; }
        Group { Anchor: (Height: 18); }

        Group {
          Anchor: (Height: 500);
          LayoutMode: Left;

          Group {
            Anchor: (Width: 335, Height: 500);
            LayoutMode: Top;

            Group { Anchor: (Height: 2); Background: #c8a2ff; }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;

              Group { Anchor: (Width: 2); Background: #c8a2ff; }

              Group {
                FlexWeight: 1;

                Group {
                  Anchor: (Full: 0);
                  LayoutMode: Top;

                  Group { FlexWeight: 1; Background: #2e1250(0.55); }
                  Group { FlexWeight: 1; Background: #311354(0.55); }
                  Group { FlexWeight: 1; Background: #331458(0.55); }
                  Group { FlexWeight: 1; Background: #36155b(0.55); }
                  Group { FlexWeight: 1; Background: #39165f(0.55); }
                  Group { FlexWeight: 1; Background: #3b1763(0.55); }
                  Group { FlexWeight: 1; Background: #3e1867(0.55); }
                  Group { FlexWeight: 1; Background: #40196b(0.55); }
                  Group { FlexWeight: 1; Background: #431a6f(0.55); }
                  Group { FlexWeight: 1; Background: #461b72(0.55); }
                  Group { FlexWeight: 1; Background: #481c76(0.55); }
                  Group { FlexWeight: 1; Background: #4b1d7a(0.55); }
                }
                TextButton #Mode0 {
                  Text: "";
                  Anchor: (Full: 0);
                  Style: @Card;
                }

                Label {
                  Text: "ЗАХВАТ ФЛАГА";
                  Anchor: (Height: 36, Bottom: 150);
                  Style: (FontSize: 28, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
                }
                Label {
                  Text: "Две команды бьются за флаг";
                  Anchor: (Height: 26, Bottom: 112);
                  Style: (FontSize: 16, TextColor: #c8a2ff, HorizontalAlignment: Center);
                }
                Label {
                  Text: "соперника. Кто принёс — тот и выиграл.";
                  Anchor: (Height: 26, Bottom: 84);
                  Style: (FontSize: 16, TextColor: #c8a2ff, HorizontalAlignment: Center);
                }
              }

              Group { Anchor: (Width: 2); Background: #c8a2ff; }
            }

            Group { Anchor: (Height: 2); Background: #c8a2ff; }
          }
          Group { Anchor: (Width: 16); }
          Group {
            Anchor: (Width: 335, Height: 500);
            LayoutMode: Top;

            Group { Anchor: (Height: 2); Background: #c8a2ff; }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;

              Group { Anchor: (Width: 2); Background: #c8a2ff; }

              Group {
                FlexWeight: 1;

                Group {
                  Anchor: (Full: 0);
                  LayoutMode: Top;

                  Group { FlexWeight: 1; Background: #2e1250(0.55); }
                  Group { FlexWeight: 1; Background: #311354(0.55); }
                  Group { FlexWeight: 1; Background: #331458(0.55); }
                  Group { FlexWeight: 1; Background: #36155b(0.55); }
                  Group { FlexWeight: 1; Background: #39165f(0.55); }
                  Group { FlexWeight: 1; Background: #3b1763(0.55); }
                  Group { FlexWeight: 1; Background: #3e1867(0.55); }
                  Group { FlexWeight: 1; Background: #40196b(0.55); }
                  Group { FlexWeight: 1; Background: #431a6f(0.55); }
                  Group { FlexWeight: 1; Background: #461b72(0.55); }
                  Group { FlexWeight: 1; Background: #481c76(0.55); }
                  Group { FlexWeight: 1; Background: #4b1d7a(0.55); }
                }
                TextButton #Mode1 {
                  Text: "";
                  Anchor: (Full: 0);
                  Style: @Card;
                }

                Label {
                  Text: "ВЫЖИВАНИЕ";
                  Anchor: (Height: 36, Bottom: 150);
                  Style: (FontSize: 28, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
                }
                Label {
                  Text: "Волны монстров идут одна за другой.";
                  Anchor: (Height: 26, Bottom: 112);
                  Style: (FontSize: 16, TextColor: #c8a2ff, HorizontalAlignment: Center);
                }
                Label {
                  Text: "Продержись дольше всех и забери награду.";
                  Anchor: (Height: 26, Bottom: 84);
                  Style: (FontSize: 16, TextColor: #c8a2ff, HorizontalAlignment: Center);
                }
              }

              Group { Anchor: (Width: 2); Background: #c8a2ff; }
            }

            Group { Anchor: (Height: 2); Background: #c8a2ff; }
          }
          Group { Anchor: (Width: 16); }
          Group {
            Anchor: (Width: 335, Height: 500);
            LayoutMode: Top;

            Group { Anchor: (Height: 2); Background: #c8a2ff; }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;

              Group { Anchor: (Width: 2); Background: #c8a2ff; }

              Group {
                FlexWeight: 1;

                Group {
                  Anchor: (Full: 0);
                  LayoutMode: Top;

                  Group { FlexWeight: 1; Background: #2e1250(0.55); }
                  Group { FlexWeight: 1; Background: #311354(0.55); }
                  Group { FlexWeight: 1; Background: #331458(0.55); }
                  Group { FlexWeight: 1; Background: #36155b(0.55); }
                  Group { FlexWeight: 1; Background: #39165f(0.55); }
                  Group { FlexWeight: 1; Background: #3b1763(0.55); }
                  Group { FlexWeight: 1; Background: #3e1867(0.55); }
                  Group { FlexWeight: 1; Background: #40196b(0.55); }
                  Group { FlexWeight: 1; Background: #431a6f(0.55); }
                  Group { FlexWeight: 1; Background: #461b72(0.55); }
                  Group { FlexWeight: 1; Background: #481c76(0.55); }
                  Group { FlexWeight: 1; Background: #4b1d7a(0.55); }
                }
                TextButton #Mode2 {
                  Text: "";
                  Anchor: (Full: 0);
                  Style: @Card;
                }

                Label {
                  Text: "ПАРКУР";
                  Anchor: (Height: 36, Bottom: 150);
                  Style: (FontSize: 28, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
                }
                Label {
                  Text: "Трасса с препятствиями на время.";
                  Anchor: (Height: 26, Bottom: 112);
                  Style: (FontSize: 16, TextColor: #c8a2ff, HorizontalAlignment: Center);
                }
                Label {
                  Text: "Побей рекорд сервера и попади в топ.";
                  Anchor: (Height: 26, Bottom: 84);
                  Style: (FontSize: 16, TextColor: #c8a2ff, HorizontalAlignment: Center);
                }
              }

              Group { Anchor: (Width: 2); Background: #c8a2ff; }
            }

            Group { Anchor: (Height: 2); Background: #c8a2ff; }
          }
          Group { Anchor: (Width: 16); }
          Group {
            Anchor: (Width: 335, Height: 500);
            LayoutMode: Top;

            Group { Anchor: (Height: 2); Background: #c8a2ff; }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;

              Group { Anchor: (Width: 2); Background: #c8a2ff; }

              Group {
                FlexWeight: 1;

                Group {
                  Anchor: (Full: 0);
                  LayoutMode: Top;

                  Group { FlexWeight: 1; Background: #2e1250(0.55); }
                  Group { FlexWeight: 1; Background: #311354(0.55); }
                  Group { FlexWeight: 1; Background: #331458(0.55); }
                  Group { FlexWeight: 1; Background: #36155b(0.55); }
                  Group { FlexWeight: 1; Background: #39165f(0.55); }
                  Group { FlexWeight: 1; Background: #3b1763(0.55); }
                  Group { FlexWeight: 1; Background: #3e1867(0.55); }
                  Group { FlexWeight: 1; Background: #40196b(0.55); }
                  Group { FlexWeight: 1; Background: #431a6f(0.55); }
                  Group { FlexWeight: 1; Background: #461b72(0.55); }
                  Group { FlexWeight: 1; Background: #481c76(0.55); }
                  Group { FlexWeight: 1; Background: #4b1d7a(0.55); }
                }
                TextButton #Mode3 {
                  Text: "";
                  Anchor: (Full: 0);
                  Style: @Card;
                }

                Label {
                  Text: "АРЕНА";
                  Anchor: (Height: 36, Bottom: 150);
                  Style: (FontSize: 28, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
                }
                Label {
                  Text: "Бои один на один на закрытой арене.";
                  Anchor: (Height: 26, Bottom: 112);
                  Style: (FontSize: 16, TextColor: #c8a2ff, HorizontalAlignment: Center);
                }
                Label {
                  Text: "Победитель остаётся, проигравший ждёт.";
                  Anchor: (Height: 26, Bottom: 84);
                  Style: (FontSize: 16, TextColor: #c8a2ff, HorizontalAlignment: Center);
                }
              }

              Group { Anchor: (Width: 2); Background: #c8a2ff; }
            }

            Group { Anchor: (Height: 2); Background: #c8a2ff; }
          }
        }

        Group { Anchor: (Height: 14); }

        Label {
          Text: "ESC — закрыть меню";
          Anchor: (Height: 18);
          Style: (FontSize: 13, TextColor: #9b5de5, HorizontalAlignment: Center);
        }
      }
    }

    Group { Anchor: (Width: 2); Background: #9b5de5; }
  }

  Group { Anchor: (Height: 2); Background: #9b5de5; }
}
