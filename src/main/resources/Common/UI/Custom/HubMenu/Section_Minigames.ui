// Окно «Мини-игры». Метка сверху, название, две строки описания — в строках Text.

@Card = TextButtonStyle(
  Default: (Background: #c9b3ff(0.04), LabelStyle: (FontSize: 26, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #a35dff(0.16), LabelStyle: (FontSize: 26, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #a35dff(0.32), LabelStyle: (FontSize: 26, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@Flat = TextButtonStyle(
  Default: (Background: #c9b3ff(0.06), LabelStyle: (FontSize: 15, TextColor: #bfb2d9, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #a35dff(0.55), LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #a35dff(0.80), LabelStyle: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

Group {
  Anchor: (Width: 1440, Height: 660);
  LayoutMode: Top;

  Group { Anchor: (Height: 2); Background: #3a2a55; }

  Group {
    FlexWeight: 1;
    LayoutMode: Left;

    Group { Anchor: (Width: 2); Background: #3a2a55; }

    Group {
      FlexWeight: 1;

      Group {
        Anchor: (Full: 0);
        LayoutMode: Top;

        Group { FlexWeight: 1; Background: #0a0612(0.88); }
        Group { FlexWeight: 1; Background: #0c0715(0.88); }
        Group { FlexWeight: 1; Background: #0e0819(0.88); }
        Group { FlexWeight: 1; Background: #100a1c(0.88); }
        Group { FlexWeight: 1; Background: #120b20(0.88); }
        Group { FlexWeight: 1; Background: #140c23(0.88); }
        Group { FlexWeight: 1; Background: #160d27(0.88); }
        Group { FlexWeight: 1; Background: #180f2a(0.88); }
        Group { FlexWeight: 1; Background: #1a102e(0.88); }
        Group { FlexWeight: 1; Background: #1c1131(0.88); }
      }

      Group {
        Anchor: (Full: 0);
        LayoutMode: Top;
        Padding: (Full: 24);

        Group {
          Anchor: (Height: 56);
          LayoutMode: Left;

            Group {
              Anchor: (Width: 160, Height: 44);
              LayoutMode: Top;

              Group { Anchor: (Height: 2); Background: #3a2a55; }

              Group {
                FlexWeight: 1;
                LayoutMode: Left;

                Group { Anchor: (Width: 2); Background: #3a2a55; }

                Group {
                  FlexWeight: 1;

                  TextButton #BackButton {
                    Text: "НАЗАД";
                    Anchor: (Full: 0);
                    Style: @Flat;
                  }
                }

                Group { Anchor: (Width: 2); Background: #3a2a55; }
              }

              Group { Anchor: (Height: 2); Background: #3a2a55; }
            }

            Group {
              FlexWeight: 1;
              LayoutMode: Center;

              Label {
                Text: "МИНИ-ИГРЫ";
                Anchor: (Height: 48);
                Style: (FontSize: 36, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
              }
            }

            Group { Anchor: (Width: 160); }
        }

        Group { Anchor: (Height: 2); Background: #a35dff; }
        Group { Anchor: (Height: 16); }

        Group {
          Anchor: (Height: 500);
          LayoutMode: Left;

          Group {
            Anchor: (Width: 335, Height: 500);
            LayoutMode: Top;

            Group { Anchor: (Height: 2); Background: #d8c4ff; }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;

              Group { Anchor: (Width: 2); Background: #d8c4ff; }

              Group {
                FlexWeight: 1;

                Group {
                  Anchor: (Full: 0);
                  LayoutMode: Top;

                  Group { FlexWeight: 1; Background: #140c22(0.75); }
                  Group { FlexWeight: 1; Background: #160d25(0.75); }
                  Group { FlexWeight: 1; Background: #180f28(0.75); }
                  Group { FlexWeight: 1; Background: #1b102c(0.75); }
                  Group { FlexWeight: 1; Background: #1d112f(0.75); }
                  Group { FlexWeight: 1; Background: #1f1332(0.75); }
                  Group { FlexWeight: 1; Background: #211435(0.75); }
                  Group { FlexWeight: 1; Background: #241539(0.75); }
                  Group { FlexWeight: 1; Background: #26173c(0.75); }
                  Group { FlexWeight: 1; Background: #28183f(0.75); }
                }
                TextButton #Mode0 {
                  Text: "";
                  Anchor: (Full: 0);
                  Style: @Card;
                }

                Label {
                  Text: "ДОСТУПНО";
                  Anchor: (Height: 22, Bottom: 196);
                  Style: (FontSize: 14, TextColor: #a35dff, HorizontalAlignment: Center, RenderBold: true);
                }
                Label {
                  Text: "ЗАХВАТ ФЛАГА";
                  Anchor: (Height: 36, Bottom: 152);
                  Style: (FontSize: 28, TextColor: #ffffff, HorizontalAlignment: Center, RenderBold: true);
                }
                Label {
                  Text: "Две команды бьются за флаг";
                  Anchor: (Height: 26, Bottom: 112);
                  Style: (FontSize: 16, TextColor: #bfb2d9, HorizontalAlignment: Center);
                }
                Label {
                  Text: "соперника. Кто принёс — тот и выиграл.";
                  Anchor: (Height: 26, Bottom: 84);
                  Style: (FontSize: 16, TextColor: #bfb2d9, HorizontalAlignment: Center);
                }
              }

              Group { Anchor: (Width: 2); Background: #d8c4ff; }
            }

            Group { Anchor: (Height: 2); Background: #d8c4ff; }
          }
          Group { Anchor: (Width: 16); }
          Group {
            Anchor: (Width: 335, Height: 500);
            LayoutMode: Top;

            Group { Anchor: (Height: 2); Background: #3a2a55; }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;

              Group { Anchor: (Width: 2); Background: #3a2a55; }

              Group {
                FlexWeight: 1;

                Group {
                  Anchor: (Full: 0);
                  LayoutMode: Top;

                  Group { FlexWeight: 1; Background: #140c22(0.75); }
                  Group { FlexWeight: 1; Background: #160d25(0.75); }
                  Group { FlexWeight: 1; Background: #180f28(0.75); }
                  Group { FlexWeight: 1; Background: #1b102c(0.75); }
                  Group { FlexWeight: 1; Background: #1d112f(0.75); }
                  Group { FlexWeight: 1; Background: #1f1332(0.75); }
                  Group { FlexWeight: 1; Background: #211435(0.75); }
                  Group { FlexWeight: 1; Background: #241539(0.75); }
                  Group { FlexWeight: 1; Background: #26173c(0.75); }
                  Group { FlexWeight: 1; Background: #28183f(0.75); }
                }
                TextButton #Mode1 {
                  Text: "";
                  Anchor: (Full: 0);
                  Style: @Card;
                }

                Label {
                  Text: "ДОСТУПНО";
                  Anchor: (Height: 22, Bottom: 196);
                  Style: (FontSize: 14, TextColor: #a35dff, HorizontalAlignment: Center, RenderBold: true);
                }
                Label {
                  Text: "ВЫЖИВАНИЕ";
                  Anchor: (Height: 36, Bottom: 152);
                  Style: (FontSize: 28, TextColor: #bfb2d9, HorizontalAlignment: Center, RenderBold: true);
                }
                Label {
                  Text: "Волны монстров идут одна за другой.";
                  Anchor: (Height: 26, Bottom: 112);
                  Style: (FontSize: 16, TextColor: #6f6189, HorizontalAlignment: Center);
                }
                Label {
                  Text: "Продержись дольше всех и забери награду.";
                  Anchor: (Height: 26, Bottom: 84);
                  Style: (FontSize: 16, TextColor: #6f6189, HorizontalAlignment: Center);
                }
              }

              Group { Anchor: (Width: 2); Background: #3a2a55; }
            }

            Group { Anchor: (Height: 2); Background: #3a2a55; }
          }
          Group { Anchor: (Width: 16); }
          Group {
            Anchor: (Width: 335, Height: 500);
            LayoutMode: Top;

            Group { Anchor: (Height: 2); Background: #3a2a55; }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;

              Group { Anchor: (Width: 2); Background: #3a2a55; }

              Group {
                FlexWeight: 1;

                Group {
                  Anchor: (Full: 0);
                  LayoutMode: Top;

                  Group { FlexWeight: 1; Background: #140c22(0.75); }
                  Group { FlexWeight: 1; Background: #160d25(0.75); }
                  Group { FlexWeight: 1; Background: #180f28(0.75); }
                  Group { FlexWeight: 1; Background: #1b102c(0.75); }
                  Group { FlexWeight: 1; Background: #1d112f(0.75); }
                  Group { FlexWeight: 1; Background: #1f1332(0.75); }
                  Group { FlexWeight: 1; Background: #211435(0.75); }
                  Group { FlexWeight: 1; Background: #241539(0.75); }
                  Group { FlexWeight: 1; Background: #26173c(0.75); }
                  Group { FlexWeight: 1; Background: #28183f(0.75); }
                }
                TextButton #Mode2 {
                  Text: "";
                  Anchor: (Full: 0);
                  Style: @Card;
                }

                Label {
                  Text: "СКОРО";
                  Anchor: (Height: 22, Bottom: 196);
                  Style: (FontSize: 14, TextColor: #6f6189, HorizontalAlignment: Center, RenderBold: true);
                }
                Label {
                  Text: "ПАРКУР";
                  Anchor: (Height: 36, Bottom: 152);
                  Style: (FontSize: 28, TextColor: #bfb2d9, HorizontalAlignment: Center, RenderBold: true);
                }
                Label {
                  Text: "Трасса с препятствиями на время.";
                  Anchor: (Height: 26, Bottom: 112);
                  Style: (FontSize: 16, TextColor: #6f6189, HorizontalAlignment: Center);
                }
                Label {
                  Text: "Побей рекорд сервера и попади в топ.";
                  Anchor: (Height: 26, Bottom: 84);
                  Style: (FontSize: 16, TextColor: #6f6189, HorizontalAlignment: Center);
                }
              }

              Group { Anchor: (Width: 2); Background: #3a2a55; }
            }

            Group { Anchor: (Height: 2); Background: #3a2a55; }
          }
          Group { Anchor: (Width: 16); }
          Group {
            Anchor: (Width: 335, Height: 500);
            LayoutMode: Top;

            Group { Anchor: (Height: 2); Background: #3a2a55; }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;

              Group { Anchor: (Width: 2); Background: #3a2a55; }

              Group {
                FlexWeight: 1;

                Group {
                  Anchor: (Full: 0);
                  LayoutMode: Top;

                  Group { FlexWeight: 1; Background: #140c22(0.75); }
                  Group { FlexWeight: 1; Background: #160d25(0.75); }
                  Group { FlexWeight: 1; Background: #180f28(0.75); }
                  Group { FlexWeight: 1; Background: #1b102c(0.75); }
                  Group { FlexWeight: 1; Background: #1d112f(0.75); }
                  Group { FlexWeight: 1; Background: #1f1332(0.75); }
                  Group { FlexWeight: 1; Background: #211435(0.75); }
                  Group { FlexWeight: 1; Background: #241539(0.75); }
                  Group { FlexWeight: 1; Background: #26173c(0.75); }
                  Group { FlexWeight: 1; Background: #28183f(0.75); }
                }
                TextButton #Mode3 {
                  Text: "";
                  Anchor: (Full: 0);
                  Style: @Card;
                }

                Label {
                  Text: "СКОРО";
                  Anchor: (Height: 22, Bottom: 196);
                  Style: (FontSize: 14, TextColor: #6f6189, HorizontalAlignment: Center, RenderBold: true);
                }
                Label {
                  Text: "АРЕНА";
                  Anchor: (Height: 36, Bottom: 152);
                  Style: (FontSize: 28, TextColor: #bfb2d9, HorizontalAlignment: Center, RenderBold: true);
                }
                Label {
                  Text: "Бои один на один на закрытой арене.";
                  Anchor: (Height: 26, Bottom: 112);
                  Style: (FontSize: 16, TextColor: #6f6189, HorizontalAlignment: Center);
                }
                Label {
                  Text: "Победитель остаётся, проигравший ждёт.";
                  Anchor: (Height: 26, Bottom: 84);
                  Style: (FontSize: 16, TextColor: #6f6189, HorizontalAlignment: Center);
                }
              }

              Group { Anchor: (Width: 2); Background: #3a2a55; }
            }

            Group { Anchor: (Height: 2); Background: #3a2a55; }
          }
        }

        Group { Anchor: (Height: 14); }

        Label {
          Text: "ESC — ЗАКРЫТЬ";
          Anchor: (Height: 20);
          Style: (FontSize: 15, TextColor: #a35dff, HorizontalAlignment: Center, RenderBold: true);
        }
      }
    }

    Group { Anchor: (Width: 2); Background: #3a2a55; }
  }

  Group { Anchor: (Height: 2); Background: #3a2a55; }
}
